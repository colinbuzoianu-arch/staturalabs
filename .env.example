DATABASE_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

SUPABASE_SECRET_KEY="sb_secret_..."

# 32-byte base64 key for health sub-compartment field encryption (P10c). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HEALTH_DATA_ENCRYPTION_KEY=

# P13 §4: enforce TOTP MFA for high-privilege / health roles. Off until the
# Supabase project's MFA setting is enabled on staging and the enrol flow is
# exercised with a real authenticator app (SLD_P13_MFA_ROLLOUT.md). "true" to arm.
MFA_ENFORCED=false
