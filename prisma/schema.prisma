// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Schema shape is governed by ERGO_COMPLIANCE_BY_DESIGN.md §3.1-§3.3 and §4.
// Non-negotiable: no field here may store or reference a specific worker's
// identity (employee_id, name, badge number, etc.). The primary entity chain
// is company -> site -> workstation -> task -> posture_sample -> body_region_score,
// with manual_input attached to a task and assessment_session grouping a
// dated set of tasks at a workstation (via assessment_session_task).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The tenant. Top of the hierarchy — every site (and transitively every
/// workstation) belongs to exactly one company.
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites                Site[]
  platformUsers        PlatformUser[]
  hazards              Hazard[]
  environmentalAspects EnvironmentalAspect[]
  companyModules       CompanyModule[]
  persons              Person[]
  substances           Substance[]
  inspectionTemplates  InspectionTemplate[]
}

/// A physical location/department within a company (conversationally
/// "workplace"). Belongs to exactly one company.
model Site {
  id             String      @id @default(cuid())
  companyId      String
  name           String
  address        String?
  // Which legal/jurisdiction frame applies to this site's data (limit
  // catalog, SGD generator, exposure evaluation) — deliberately NOT on
  // Company: a company can have sites in more than one country, and the
  // legal frame follows the physical site, not the tenant
  // (SLD_IMPLEMENTATION_PLAN_austria-first.md §4.3). Always explicit, never
  // defaulted or inferred (ERGO_COMPLIANCE_BY_DESIGN.md §3.15) — every
  // existing row was backfilled explicitly in the migration that added this
  // column, same discipline as AssessmentSession.mode.
  country        CountryCode
  // E4 (SLD_IMPLEMENTATION_PLAN_hazards-and-environment.md §6): a site with
  // a valid EMAS environmental statement is exempt from the separate AWK —
  // the statement counts in lieu (§10 Abs. 1 AWG 2002). Default false (a
  // site is not EMAS-registered unless explicitly marked — a safe, correct
  // default, unlike the semantically-required country/mode fields).
  emasRegistered Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Restrict: forces explicit offboarding of a company's sites rather than
  // an accidental cascade wipe of everything under it.
  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workstations             Workstation[]
  siteAssignments          SiteAssignment[]
  orgUnits                 OrgUnit[]
  processes                Process[]
  riskAssessments          RiskAssessment[]
  actions                  Action[]
  floorPlans               FloorPlan[]
  environmentalAssessments EnvironmentalAssessment[]
  wasteStreams             WasteStream[]
  generatedDocuments       GeneratedDocument[]
  documents                Document[]
  substanceUses            SubstanceUse[]
  operatingInstructions    OperatingInstruction[]
  inspectionTemplates      InspectionTemplate[]
  inspections              Inspection[]

  @@index([companyId])
}

/// Jurisdiction a Site is physically located in — drives which legal limit
/// catalog, SGD template, and country-pack terminology apply
/// (ERGO_COMPLIANCE_BY_DESIGN.md §3.15,
/// SLD_IMPLEMENTATION_PLAN_austria-first.md §4). Not the same axis as
/// Locale (src/lib/i18n/locale.ts, en/de/ro, "what language") — country
/// answers "which law/limits/terminology," language answers "what words."
/// The two are deliberately kept on separate objects; do not merge them.
enum CountryCode {
  AT
  DE
  CH
  RO
}

/// Platform roles, from broadest to narrowest scope. See
/// ERGO_COMPLIANCE_BY_DESIGN.md "Tenant & role hierarchy" for the escalation
/// flow (site_admin -> company_admin -> l3_support -> super_admin).
enum PlatformRole {
  SUPER_ADMIN
  L3_SUPPORT
  COMPANY_ADMIN
  SITE_ADMIN
  // P7d (SLD_P7B_DEFERRALS_RESOLVED.md §B): the three provisionable roles.
  // occupational_physician / works_council stay deferred to P10.
  EHS_SPECIALIST
  MANAGER
  EMPLOYEE
}

// P7d §B.1: the scope of a RoleAssignment. COMPANY/SELF carry no scopeId; SITE
// carries a siteId; ORG_UNIT carries an orgUnitId (inherits to descendants).
enum ScopeType {
  COMPANY
  SITE
  ORG_UNIT
  SELF
}

/// The only human-account table in the schema — unlike workstation, a name
/// and email here are expected: these are platform users (EHS managers, HR
/// staff, site coordinators, internal support/admin), not assessment
/// subjects. Never let a field from here find its way onto Workstation or
/// anything below it.
///
/// `id` is intentionally not a generated cuid: it is the same UUID as the
/// corresponding Supabase `auth.users.id` row (one auth identity, one
/// platform_user row). Provisioning only ever happens via an invite-only
/// admin flow — there is no public sign-up path that creates either row.
///
/// `companyId` is enforced (nullable for super_admin/l3_support, required
/// for company_admin/site_admin) by a CHECK constraint added in migration
/// SQL, since Prisma's schema language has no native way to express a
/// column constraint conditioned on another column's value. Likewise the FK
/// from `id` to `auth.users.id` is hand-added SQL, since Prisma doesn't
/// model the `auth` schema. Prisma's drift detection doesn't know about
/// either: review any future auto-generated migration touching this table
/// for an accidental `DROP CONSTRAINT` before applying it.
model PlatformUser {
  id        String       @id @db.Uuid
  role      PlatformRole
  companyId String?
  name      String
  email     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Restrict: a company with an active admin account can't be deleted out
  // from under them.
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  siteAssignments SiteAssignment[]
  roleAssignments RoleAssignment[]
}

/// Scopes a site_admin to the specific site(s) they cover. Only meaningful
/// for the site_admin role — company_admin's scope is implicit (every site
/// where site.companyId matches their own companyId) and needs no join row.
model SiteAssignment {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  siteId    String
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

/// A physical work area/station being assessed. Primary entity — never linked
/// to a specific worker (§3.1, §4). Belongs to exactly one site; a site
/// belongs to exactly one company (tenant).
model Workstation {
  id          String   @id @default(cuid())
  siteId      String
  orgUnitId   String?
  name        String
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict, not Cascade: a site should be offboarded/archived explicitly,
  // never have its workstations (and their assessment history) silently
  // wiped out as a side effect of deleting the site (§3.6 audit trail).
  //
  // orgUnitId is additive-only grouping/presentation on top of an access
  // model that already works via siteId — see the OrgUnit model doc
  // comment below. Never make this required or derive site from the org
  // tree; siteId stays the sole authorization-relevant column here.
  site                     Site                      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  orgUnit                  OrgUnit?                  @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  tasks                    Task[]
  assessmentSessions       AssessmentSession[]
  riskAssessments          RiskAssessment[]
  planPositions            WorkstationPlanPosition[]
  environmentalAssessments EnvironmentalAssessment[]
  wasteStreamOrigins       WasteStream[]
  substanceUses            SubstanceUse[]

  @@index([siteId])
  @@index([orgUnitId])
}

/// A specific job/task performed at a workstation (e.g. "pallet loading",
/// "component inspection"). Describes the work, never the worker performing it.
/// Belongs to exactly one workstation; grouped into dated assessments via
/// AssessmentSessionTask rather than owned by any one session, since the
/// same task is expected to be re-assessed over time.
model Task {
  id            String   @id @default(cuid())
  workstationId String
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Restrict, matching every other relation in this chain: a task with
  // assessment history behind it can't be deleted out from under that
  // history (§3.6 audit trail).
  workstation        Workstation             @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  postureSamples     PostureSample[]
  manualInputs       ManualInput[]
  assessmentSessions AssessmentSessionTask[]
  processTasks       ProcessTask[]
  planPositions      TaskPlanPosition[]
  riskFindings       RiskFinding[]

  @@index([workstationId])
}

/// Dual-mode decision (§5, ERGO_COMPLIANCE_BY_DESIGN.md, resolved
/// 2026-07): SCHEDULED is the current, only-implemented regime —
/// operator-triggered discrete captures, workstation-audit framing.
/// CONTINUOUS is designed for structurally (mandate 3.11) but has no
/// implementation yet — createAssessmentSession()
/// (src/lib/assessment-session/create-assessment-session.ts) throws if
/// asked to create one. Do not remove that guard just because this enum
/// value exists; the schema being ready and the feature being ready are
/// deliberately different milestones (feature flag + a documented
/// worker-rep consent artifact per deployment are the actual gate).
enum AssessmentMode {
  SCHEDULED
  CONTINUOUS
}

/// A dated assessment event at a workstation, grouping the set of tasks
/// that were assessed during it. A task can appear in more than one
/// session over time (it's re-assessed on a later date), so the task set
/// is a join (AssessmentSessionTask), not a direct FK on Task.
///
/// `mode` is recorded per session, never inferred or left to a default at
/// read time — see AssessmentMode doc comment and mandate 3.11. Existing
/// rows predating this field were backfilled to SCHEDULED explicitly in
/// the migration that added it, not left to ride on the column default.
///
/// `pilotContext` is free-text, internal-only metadata (§3.6 audit trail)
/// for annotating why a session exists — e.g. a technical pilot at a
/// partner site vs. an internal validation study vs. a real customer
/// engagement — so pilot/test data can be cleanly separated from real
/// customer data in later analysis. Nullable: most sessions won't have it
/// set. Deliberately not surfaced in the customer-facing dashboard
/// (src/app/(app)/**) — super_admin-only, via the internal /admin tool.
model AssessmentSession {
  id            String         @id @default(cuid())
  workstationId String
  mode          AssessmentMode @default(SCHEDULED)
  pilotContext  String?
  startedAt     DateTime
  endedAt       DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workstation Workstation             @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  tasks       AssessmentSessionTask[]
  actions     Action[]

  @@index([workstationId])
}

/// Join table: which tasks were covered by a given assessment session.
model AssessmentSessionTask {
  id                  String   @id @default(cuid())
  assessmentSessionId String
  taskId              String
  createdAt           DateTime @default(now())

  assessmentSession AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Restrict)
  task              Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([assessmentSessionId, taskId])
  @@index([taskId])
}

/// The viewpoint a PostureSample was captured from. Matters for which joint
/// angles the sample can support: sagittal (side-on) is needed for trunk
/// flexion, frontal (front-on) for lateral bending/deviation; oblique views
/// are recorded as such rather than misclassified as one of the two.
enum CameraAngle {
  FRONTAL
  SAGITTAL
  OBLIQUE
}

/// How a PostureSample's angles were obtained (ERGO_COMPLIANCE_BY_DESIGN.md
/// §3.16, SLD_IMPLEMENTATION_PLAN_austria-first.md §5) — recorded on every
/// sample, never inferred, so a generated artifact can always state
/// whether a value is camera-measured or manually entered rather than
/// presenting the two as interchangeable. IMPORTED_MODEL is reserved, no
/// implementation anywhere in the app — createPostureSample()
/// (src/lib/capture/create-posture-sample.ts) throws if asked for it, same
/// discipline as createAssessmentSession() throwing on
/// AssessmentMode.CONTINUOUS.
enum PostureSampleSource {
  CAMERA_MEDIAPIPE
  MANUAL_ENTRY
  IMPORTED_MODEL
}

/// Whether a PostureSample's keypoints have been reviewed/adjusted by a
/// human yet. PENDING_REVIEW is the state every new sample is created in —
/// the scoring pipeline (POST /api/posture-samples) always scores from the
/// original `keypoints` and sets this on creation. VALIDATED means a
/// reviewer has confirmed (optionally adjusting) the landmark positions,
/// re-scored from `validatedKeypoints` by validatePostureSample
/// ((app)/tasks/[taskId]/actions.ts). A VALIDATED sample isn't permanently
/// frozen: reopenPostureSampleForEdit (same file) flips it back to
/// PENDING_REVIEW so it can be re-validated — every such transition, in
/// either direction, is recorded in PostureSampleValidationEvent (below),
/// never silent. See PostureSample.validatedKeypoints for why the original
/// `keypoints` column is never overwritten.
enum ValidationStatus {
  PENDING_REVIEW
  VALIDATED
}

/// A single derived-pose snapshot captured while a task is performed.
/// `source` records how it was obtained (ERGO_COMPLIANCE_BY_DESIGN.md
/// §3.16) — never inferred, always explicit, backfilled to
/// CAMERA_MEDIAPIPE for every pre-existing row.
///
/// `keypoints` holds only joint positions/angles produced by client-side
/// MediaPipe processing — never a raw video frame, and never data
/// reusable to re-identify a person (§3.2, §4). This column is NEVER
/// overwritten once written: it stays the immutable audit-trail record of
/// exactly what MediaPipe produced, even after a human review adjusts it.
/// Nullable, and only actually null for `source = MANUAL_ENTRY` — see
/// `manualAngles` below and the hand-added
/// `PostureSample_source_shape_check` CHECK (migration SQL) that enforces
/// keypoints/manualAngles presence by source, same pattern as
/// `ManualInput_value_shape_check`.
///
/// `manualAngles` is the manual-entry counterpart to `keypoints`: the raw
/// angle an assessor entered per computed BodyRegion (goniometer/tape
/// measure, flexion-from-neutral convention — see CLAUDE.md "Scoring
/// methodology"), stored regardless of whether it matched a ScoringRule.
/// It exists specifically so a region that didn't match any rule can still
/// be reported honestly at read time (`no-matching-rule`, with the actual
/// entered degrees) without recomputing — `BodyRegionScore` only ever
/// holds rows for regions that DID match (see that model's own comment),
/// so an unmatched manual angle has nowhere else to live. Never set
/// alongside `keypoints`.
///
/// `validatedKeypoints` holds a reviewer's adjusted landmark positions,
/// separate from `keypoints` above. `validationStatus = VALIDATED`
/// requires `validatedKeypoints`/`validatedAt`/`validatedByUserId` to all
/// be set together — enforced by a HAND-ADDED CHECK constraint in
/// migration SQL (`PostureSample_validation_completeness_check`, same
/// technique as ManualInput_value_shape_check), added NOT VALID against
/// pre-existing rows (see that migration's comments for why). While
/// PENDING_REVIEW, a reviewer may save `validatedKeypoints` alone as a
/// mid-adjustment draft — the CHECK only fires once `validationStatus`
/// flips to VALIDATED. `validatedByUserId` references PlatformUser only, a
/// plain @db.Uuid column not a DB-level FK — same pattern as
/// RiskAssessment.assessorUserId. This whole validation workflow is about
/// reviewing/adjusting *keypoints* — it doesn't apply to a MANUAL_ENTRY
/// sample (no keypoints exist to adjust), so those samples stay
/// PENDING_REVIEW permanently; `validatePostureSample`/
/// `reopenPostureSampleForEdit` ((app)/tasks/[taskId]/actions.ts) both
/// reject any sample whose `source` isn't CAMERA_MEDIAPIPE.
///
/// Samples that predate the `validationStatus` column were backfilled to
/// VALIDATED explicitly in the migration that added it (they were already
/// human-reviewed through the old capture confirmation flow) — treating
/// them as PENDING_REVIEW would retroactively downgrade data already
/// acted on. Those specific rows have no real validatedKeypoints/
/// validatedAt/validatedByUserId (nothing to backfill them with), which is
/// exactly what the CHECK's NOT VALID addition permanently exempts.
model PostureSample {
  id                  String              @id @default(cuid())
  taskId              String
  capturedAt          DateTime
  cameraAngle         CameraAngle
  source              PostureSampleSource
  frameIndex          Int?
  keypoints           Json?
  manualAngles        Json?
  /// How long THIS specific captured/entered posture was held, in seconds
  /// (SLD_IMPLEMENTATION_PLAN_austria-first.md §6) — feeds the hold-time
  /// sub-score (see HoldTimeRule below), never the posture-band scoring
  /// itself. Optional: most samples don't record it. NOT the same quantity
  /// as `ManualInput.DURATION_SECONDS`, which is a task-level "how long
  /// does one cycle of this task take" figure, unrelated to any single
  /// posture — see that enum value's own comment. Conflating the two was
  /// flagged as a real risk when this column was added; don't.
  holdDurationSeconds Int?
  validatedKeypoints  Json?
  validationStatus    ValidationStatus
  validatedAt         DateTime?
  validatedByUserId   String?             @db.Uuid
  createdAt           DateTime            @default(now())

  task              Task                           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  bodyRegionScores  BodyRegionScore[]
  postureZoneScores PostureZoneScore[]
  validationEvents  PostureSampleValidationEvent[]

  @@index([taskId])
}

/// Append-only validationStatus transition history (§3.6) — same shape and
/// rationale as ActionStatusEvent: PENDING_REVIEW -> VALIDATED (a fresh
/// validatePostureSample call) and VALIDATED -> PENDING_REVIEW (a
/// reopenPostureSampleForEdit call) are both recorded here, with who did it
/// and an optional note, so "this measurement was edited after being
/// finalized" is always a real, attributable, queryable fact — never a
/// silent overwrite. byUserId is a plain @db.Uuid column, not a DB-level FK
/// to PlatformUser — same pattern as PostureSample.validatedByUserId and
/// ActionStatusEvent.byUserId (§3.13).
model PostureSampleValidationEvent {
  id              String            @id @default(cuid())
  postureSampleId String
  fromStatus      ValidationStatus?
  toStatus        ValidationStatus
  byUserId        String            @db.Uuid
  note            String?
  createdAt       DateTime          @default(now())

  postureSample PostureSample @relation(fields: [postureSampleId], references: [id], onDelete: Restrict)

  @@index([postureSampleId])
}

/// One body-region risk score derived from a posture sample — one row per
/// body region per sample. `scoringRuleVersion` tags which ScoringRule
/// vintage (methodologyVersion) produced the score; the lookup itself
/// (matching an angle to a ScoringRule row) is scoring-engine logic and is
/// intentionally not modeled/implemented here.
///
/// `riskBand` is nullable and, deliberately, only ever populated for
/// MANUAL_ENTRY-sourced rows (createPostureSample,
/// src/lib/capture/create-posture-sample.ts, persists it at write time
/// from the same ScoringRule match that produced `score`). The camera
/// path leaves it null: buildRegionResults' CAMERA_MEDIAPIPE branch always
/// recomputes region results live from `PostureSample.keypoints`, exactly
/// as before, so it never needs a persisted band. A manual sample has no
/// keypoints to recompute from, so its read side (buildRegionResults'
/// MANUAL_ENTRY branch) reads this column directly instead — deriving a
/// band back from `score` alone would be unreliable, since NECK's
/// non-monotonic rule set gives its two HIGH-band rows two *different*
/// riskScore values (see CLAUDE.md "Scoring methodology").
model BodyRegionScore {
  id                 String     @id @default(cuid())
  postureSampleId    String
  bodyRegion         BodyRegion
  score              Float
  riskBand           RiskBand?
  scoringRuleVersion String?
  createdAt          DateTime   @default(now())

  postureSample PostureSample @relation(fields: [postureSampleId], references: [id], onDelete: Restrict)

  @@unique([postureSampleId, bodyRegion])
  @@index([postureSampleId])
}

/// Manually entered inputs an assessor supplies for a task — load weight,
/// push/pull force, tool used — that computer vision cannot derive from
/// video alone. One row per entry, so a task can carry any number of these
/// (e.g. both a push and a pull force, or a tool plus a weight).
///
/// `value`/`unit` (numeric entries) and `textValue` (TOOL_USED) are
/// mutually exclusive depending on `inputType`, enforced by a CHECK
/// constraint added in migration SQL — see the note on PlatformUser above
/// for why this lives outside schema.prisma, and the same drift-detection
/// caveat applies here.
model ManualInput {
  id        String          @id @default(cuid())
  taskId    String
  inputType ManualInputType
  value     Float?
  unit      String?
  textValue String?
  notes     String?
  createdAt DateTime        @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

enum BodyRegion {
  NECK
  TRUNK
  SHOULDER_LEFT
  SHOULDER_RIGHT
  UPPER_ARM_LEFT
  UPPER_ARM_RIGHT
  ELBOW_LEFT
  ELBOW_RIGHT
  FOREARM_LEFT
  FOREARM_RIGHT
  WRIST_LEFT
  WRIST_RIGHT
  HIP
  KNEE_LEFT
  KNEE_RIGHT
  ANKLE_LEFT
  ANKLE_RIGHT
}

/// Qualitative risk tier a ScoringRule row falls into. ELEVATED sits between
/// MODERATE and HIGH — used where a methodology needs a fourth tier (e.g.
/// shoulder flexion) rather than collapsing straight from MODERATE to HIGH.
enum RiskBand {
  LOW
  MODERATE
  ELEVATED
  HIGH
}

/// Tracks which ScoringRule vintage is "current" for new lookups, as real
/// data rather than a code constant — so activating a new methodology
/// version is a data change (flip isActive), not a deploy, and which
/// version was active at any point in time stays reconstructable from
/// `activatedAt`.
///
/// At most one row may have isActive = true. Prisma's schema language can't
/// express a partial/filtered unique index, so that constraint is hand-added
/// in migration SQL (`MethodologyVersion_isActive_unique_when_true`) — same
/// caveat as the other hand-added constructs in this schema: Prisma's drift
/// detection doesn't know about it, review any future auto-generated
/// migration touching this table before applying it. A lookup that finds
/// zero active rows must fail closed (error), never silently fall back to
/// some other version.
model MethodologyVersion {
  version     String   @id
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  scoringRules        ScoringRule[]
  holdTimeRules       HoldTimeRule[]
  manualHandlingRules ManualHandlingRule[]
  repetitionRules     RepetitionRule[]
  postureZoneRules    PostureZoneRule[]
}

/// Body zones for the coarse posture rating (H2,
/// SLD_IMPLEMENTATION_PLAN_hazards-and-environment.md §4.1) — the founder's
/// "low / medium / high for trunk, head, arms, legs." Each zone groups the
/// fine-grained BodyRegions it covers (HEAD_NECK←NECK; TRUNK←TRUNK/HIP;
/// SHOULDERS_ARMS←SHOULDER_*/UPPER_ARM_*/ELBOW_*/FOREARM_*;
/// HANDS_WRISTS←WRIST_*; LEGS_KNEES←KNEE_*/ANKLE_*), but a zone rating is
/// its own observation, never derived from or turned into per-joint degrees
/// (§3.16 — zones never become fake angles).
enum BodyZone {
  HEAD_NECK
  TRUNK
  SHOULDERS_ARMS
  HANDS_WRISTS
  LEGS_KNEES
}

/// The three-way load level an assessor picks per zone (gering/mittel/hoch).
enum ZoneLoadLevel {
  LOW
  MEDIUM
  HIGH
}

/// How much of the task the zone's load level applies for
/// (selten/gelegentlich/überwiegend) — replaces hold time in zone mode
/// (§4.2: "Hold time doesn't apply in zone mode. It is replaced by share.").
enum ExposureShare {
  RARE
  OCCASIONAL
  PREDOMINANT
}

/// Versioned 5×3×3 zone-posture band table (H2, §4.2) — a parallel scoring
/// axis to ScoringRule, keyed by zone × level × share rather than a raw
/// angle. SLD's own thresholds, authored by the founder (not invented by
/// CC, and not LMM/KIM — §3.7), inspired by ISO 11226 / EN 1005-4's
/// observational screening logic. One row per (methodologyVersion, zone,
/// level, share). Lives under the same MethodologyVersion as every other
/// rule table so a session's scoring vintage stays a single audit anchor.
model PostureZoneRule {
  id                 String        @id @default(cuid())
  methodologyVersion String
  zone               BodyZone
  level              ZoneLoadLevel
  share              ExposureShare
  riskBand           RiskBand
  riskScore          Int
  createdAt          DateTime      @default(now())

  // Restrict: same reasoning as ScoringRule.methodology.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@unique([methodologyVersion, zone, level, share])
  @@index([methodologyVersion])
}

/// A zone-mode PostureSample's per-zone sub-score — the parallel of
/// BodyRegionScore for zone entry (§4.2). A zone-mode sample writes these
/// rows and NO BodyRegionScore rows; a region/degree sample writes
/// BodyRegionScore and no PostureZoneScore. The two never mix on one
/// sample. `methodologyVersion` pins the vintage that produced the band,
/// same provenance discipline BodyRegionScore.scoringRuleVersion follows.
model PostureZoneScore {
  id                 String        @id @default(cuid())
  postureSampleId    String
  zone               BodyZone
  level              ZoneLoadLevel
  share              ExposureShare
  riskBand           RiskBand
  riskScore          Int
  methodologyVersion String
  createdAt          DateTime      @default(now())

  postureSample PostureSample @relation(fields: [postureSampleId], references: [id], onDelete: Restrict)

  @@unique([postureSampleId, zone])
  @@index([postureSampleId])
}

/// Versioned scoring thresholds (§3.8): the "rule content" that
/// BodyRegionScore.scoringRuleVersion tags but doesn't itself hold. Rows are
/// data, not code — a new methodologyVersion is a new set of rows, never an
/// edit to existing ones, so a past score's rule version stays reproducible.
///
/// Angles are flexion-from-neutral degrees (0° = upright/anatomical
/// position), independent of which side of a bilateral joint they're for.
/// [angleMin, angleMax) bounds a band; either end may be null for an
/// open-ended band (e.g. HIGH trunk flexion has no upper bound). A body
/// region can have more than one row in the same band (see ELBOW_LEFT/RIGHT
/// HIGH: risk at both very extended and very flexed ends, with LOW as the
/// single band in between; NECK is the same shape around 0° — MODERATE and
/// HIGH each appear once on the forward-flexion side and once on the
/// backward-extension side, the latter pair with different riskScores) —
/// so there is deliberately no uniqueness constraint on
/// (methodologyVersion, bodyRegion, riskBand).
model ScoringRule {
  id                 String     @id @default(cuid())
  methodologyVersion String
  bodyRegion         BodyRegion
  riskBand           RiskBand
  riskScore          Int
  angleMin           Float?
  angleMax           Float?
  createdAt          DateTime   @default(now())

  // Restrict: a methodology version with rules still referencing it can't
  // be deleted out from under them.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@index([methodologyVersion, bodyRegion])
}

/// Versioned hold-time ceilings (SLD_IMPLEMENTATION_PLAN_austria-first.md
/// §6): "how long is it acceptable to sustain a posture that already
/// scores this severely." Independently designed by SLD, inspired by ISO
/// 11226's general "duration allowance shrinks as posture severity rises"
/// principle — not a reproduction of that standard's own figures, same
/// arm's-length relationship the rest of this scoring engine has to ISO
/// 11228/EN 1005 (ERGO_COMPLIANCE_BY_DESIGN.md §3.7). Keyed by the
/// *posture's own* riskBand (its worst scored region), not by raw angle —
/// a deliberately coarser grain than ScoringRule's angle ranges, since
/// this is a severity-tier ceiling, not a region-specific curve.
/// `maxHoldSeconds = null` means no ceiling at that severity (a LOW-band
/// posture is fine to sustain). One row per (methodologyVersion,
/// postureRiskBand) — see `HoldTimeRule_methodologyVersion_postureRiskBand_key`.
model HoldTimeRule {
  id                 String   @id @default(cuid())
  methodologyVersion String
  postureRiskBand    RiskBand
  maxHoldSeconds     Int?
  createdAt          DateTime @default(now())

  // Restrict: same reasoning as ScoringRule.methodology.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@unique([methodologyVersion, postureRiskBand])
}

/// Versioned manual-handling load-weight bands (SLD_IMPLEMENTATION_PLAN_
/// austria-first.md §7 B8): a parallel sub-score against `ManualInput`'s
/// `LOAD_WEIGHT_KG` value, closing the "§64 ASchG requires manual load
/// handling to be evaluated but Austria has no Lastenhandhabungsverordnung
/// (no mandated method)" gap the plan's §2(c) documents. Independently
/// designed by SLD, inspired by ISO 11228-1's general "the further above
/// the ~25 kg ideal-conditions reference mass, the higher the risk"
/// principle — deliberately NOT a reproduction of ISO 11228-1's own
/// Recommended Mass Limit tables or the Revised NIOSH Lifting Equation (a
/// multiplier chain over posture × load × frequency is structurally an
/// EAWS clone, forbidden by ERGO_COMPLIANCE_BY_DESIGN.md §3.7) — same
/// arm's-length relationship HoldTimeRule already has to ISO 11226.
///
/// Keyed by raw kg, same [min, max) inclusive-min/exclusive-max shape as
/// ScoringRule's angle ranges (matchManualHandlingRule mirrors
/// matchScoringRule directly) — a fresh, independent scoring axis, not
/// derived from or blended with the posture band the way HoldTimeRule is
/// (§6/§11: "parallel sub-scores, not a blended composite").
///
/// Folded into the existing `v2-2026-08` MethodologyVersion rather than a
/// new version, per the plan's explicit instruction ("folded into the
/// same v2 methodology version") — versioning per factor would turn
/// MethodologyVersion from an audit anchor into a matrix nobody can
/// reason about.
model ManualHandlingRule {
  id                 String   @id @default(cuid())
  methodologyVersion String
  riskBand           RiskBand
  riskScore          Int
  minKg              Float?
  maxKg              Float?
  createdAt          DateTime @default(now())

  // Restrict: same reasoning as ScoringRule.methodology.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@index([methodologyVersion])
}

/// Versioned repetition-count bands (SLD_NEXT_STEPS_B8b-B8f.md B8d): a
/// parallel sub-score against `ManualInput`'s `REPETITION_COUNT` value,
/// closing the "a high-rep low-load task shows three green sub-scores"
/// gap — posture, hold-time, and manual-handling were all scored, but raw
/// repetition count was captured and read by nothing. Independently
/// designed by SLD, inspired by ISO 11228-3's general "the more frequently
/// a movement repeats, the higher the risk" principle — deliberately NOT
/// a reproduction of ISO 11228-3's own frequency (repetitions/minute)
/// tables or EN 1005-5's OCRA-derived multiplier method (a full frequency
/// calculation needs cycle time and recovery time this app doesn't
/// collect in v1 — see the plan's own "no frequency calculation
/// introduced" scope note); this scores the raw REPETITION_COUNT value
/// (reps per task cycle) directly, same coarser-than-the-standard
/// relationship HoldTimeRule already has to ISO 11226.
///
/// Keyed by raw rep count, same [min, max) inclusive-min/exclusive-max
/// shape as ManualHandlingRule's kg ranges (matchRepetitionRule mirrors
/// matchManualHandlingRule directly) — a fresh, independent scoring axis,
/// never blended with posture/hold-time/manual-handling (§6/§11:
/// "parallel sub-scores, not a blended composite").
///
/// Folded into the existing `v2-2026-08` MethodologyVersion rather than a
/// new version, same "folded into the same v2 methodology version"
/// instruction ManualHandlingRule followed — a brand-new capability with
/// no historical row to preserve parity against.
model RepetitionRule {
  id                 String   @id @default(cuid())
  methodologyVersion String
  riskBand           RiskBand
  riskScore          Int
  minReps            Float?
  maxReps            Float?
  createdAt          DateTime @default(now())

  // Restrict: same reasoning as ManualHandlingRule.methodology.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@index([methodologyVersion])
}

enum ManualInputType {
  LOAD_WEIGHT_KG
  PUSH_FORCE_N
  PULL_FORCE_N
  TOOL_USED
  REPETITION_COUNT
  /// Task-cycle duration — "how long does one run of this task take,"
  /// unrelated to any single posture. NOT the same quantity as
  /// `PostureSample.holdDurationSeconds` ("how long was THIS captured
  /// posture held"); the two look similar but answer different questions
  /// and must not be conflated (SLD_IMPLEMENTATION_PLAN_austria-first.md
  /// §6 flagged this explicitly when holdDurationSeconds was added).
  DURATION_SECONDS
}

// ---------------------------------------------------------------------------
// Process / risk / action register (SLD_IMPLEMENTATION_PLAN_demo-loop.md M2).
// Sits alongside the assessment chain above, not inside it: OrgUnit and
// Process are organisational/grouping concepts layered on the existing
// Site/Workstation/Task authorization model, never load-bearing for it.
// RiskAssessment/RiskFinding/Action describe the job, never a worker — same
// §1/§3.1 test as everything above. See ERGO_COMPLIANCE_BY_DESIGN.md
// mandates 3.12-3.14.
// ---------------------------------------------------------------------------

enum OrgUnitType {
  PLANT
  DEPARTMENT
  AREA
  LINE
}

/// Organisational structure within a site. Describes the organisation of
/// work, never a person (§1, §3.1). `siteId` is denormalised onto every
/// node deliberately: authorization must never require walking this tree —
/// `canAccessSite`/`require*Access` keep working unchanged regardless of
/// how deep or shallow a given org tree is.
model OrgUnit {
  id        String      @id @default(cuid())
  siteId    String
  parentId  String?
  type      OrgUnitType
  name      String
  code      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  parent        OrgUnit?       @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      OrgUnit[]      @relation("OrgUnitTree")
  workstations  Workstation[]
  processes     Process[]
  substanceUses SubstanceUse[]

  @@index([siteId])
  @@index([parentId])
}

enum ProcessStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// A work process: an ordered set of tasks, possibly spanning workstations
/// within one site. Describes work, never a worker (§1).
model Process {
  id          String        @id @default(cuid())
  siteId      String
  orgUnitId   String?
  name        String
  code        String?
  description String?
  status      ProcessStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  site               Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  orgUnit            OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  tasks              ProcessTask[]
  riskAssessments    RiskAssessment[]
  wasteStreamOrigins WasteStream[]
  substanceUses      SubstanceUse[]

  @@index([siteId])
}

/// Join: which tasks make up a process, in what order. A task may belong to
/// more than one process — same reasoning as AssessmentSessionTask.
///
/// No separate ProcessStep entity: Task already means "a specific job
/// performed at a workstation"; a process is a sequence of those. A
/// described step with no Task is a signal to create the task, not to
/// introduce a parallel model that drifts from it.
model ProcessTask {
  id        String   @id @default(cuid())
  processId String
  taskId    String
  sequence  Int
  createdAt DateTime @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([processId, taskId])
  @@index([taskId])
}

enum HazardCategory {
  PHYSICAL_MECHANICAL
  NOISE
  VIBRATION
  LIGHTING
  CLIMATE_THERMAL
  CHEMICAL
  DUST_PARTICULATE
  BIOLOGICAL
  ERGONOMIC_MSD
  PSYCHOSOCIAL
  ELECTRICAL
  FIRE_EXPLOSION
  RADIATION
}

/// Hazard catalog. companyId == null = system catalog (seeded, shared,
/// super_admin-only to write). companyId set = a company's own additions.
model Hazard {
  id          String         @id @default(cuid())
  companyId   String?
  category    HazardCategory
  code        String
  name        String
  description String?
  isSystem    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company  Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  findings RiskFinding[]

  @@index([companyId, category])
}

/// Which risk matrix is current is data, not a code constant — same design
/// and same fail-closed contract as MethodologyVersion (ERGO_COMPLIANCE_BY_
/// DESIGN.md §3.8, §3.14). At most one isActive = true, enforced by a
/// HAND-ADDED partial unique index in migration SQL (Prisma has no
/// filtered/partial index support) — see
/// MethodologyVersion_isActive_unique_when_true for the pattern this
/// copies. A lookup that finds zero active rows must fail closed, never
/// silently fall back to another version.
model RiskMatrixVersion {
  version     String   @id
  label       String
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  cells                    RiskMatrixCell[]
  riskAssessments          RiskAssessment[]
  environmentalAssessments EnvironmentalAssessment[]
}

model RiskMatrixCell {
  id            String   @id @default(cuid())
  matrixVersion String
  probability   Int
  severity      Int
  riskScore     Int
  riskBand      RiskBand
  createdAt     DateTime @default(now())

  matrix RiskMatrixVersion @relation(fields: [matrixVersion], references: [version], onDelete: Restrict)

  @@unique([matrixVersion, probability, severity])
  @@index([matrixVersion])
}

enum RiskAssessmentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

/// A dated risk assessment of either a workstation or a process — exactly
/// one of the two, enforced by a HAND-ADDED CHECK constraint in migration
/// SQL (same technique as ManualInput_value_shape_check).
///
/// DRAFT -> IN_REVIEW -> APPROVED is ERGO_COMPLIANCE_BY_DESIGN.md §3.4
/// (mandatory human review) expressed as data. Never add an auto-approve
/// path.
///
/// pilotContext mirrors AssessmentSession.pilotContext — internal-only
/// audit metadata (§3.6) marking demo/pilot rows so they stay separable
/// from real customer data.
model RiskAssessment {
  id                   String               @id @default(cuid())
  siteId               String
  workstationId        String?
  processId            String?
  matrixVersion        String
  status               RiskAssessmentStatus @default(DRAFT)
  assessorUserId       String               @db.Uuid
  approvedByUserId     String?              @db.Uuid
  assessedAt           DateTime
  approvedAt           DateTime?
  pilotContext         String?
  notes                String?
  // P6 §6 header attributes (additive): the context an inspector / the
  // statutory document expects on an assessment. personsExposedCount is a
  // COUNT only — never an identity (§3.1). Applicable legal references are a
  // deferred join to the country LegalReference catalogue (P6b).
  activityType         ActivityType?
  personsExposedCount  Int?
  shiftPattern         String?
  productReference     String?
  processDescription   String?
  // P6 §6 review cycle: next-review date (computed from the interval or set
  // directly) and an "Überprüfung erforderlich" flag an incident / changed
  // substance / closed action raises (manual for now; the module triggers
  // land with P8 Gefahrstoffe and P10 Ereignisse).
  reviewIntervalMonths Int?
  nextReviewDate       DateTime?
  reviewRequired       Boolean              @default(false)
  reviewRequiredReason String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  site                Site                           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workstation         Workstation?                   @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  process             Process?                       @relation(fields: [processId], references: [id], onDelete: Restrict)
  matrix              RiskMatrixVersion              @relation(fields: [matrixVersion], references: [version], onDelete: Restrict)
  findings            RiskFinding[]
  categoryChecks      HazardCategoryCheck[]
  verifiedActions     Action[]                       @relation("ActionVerificationAssessment")
  legalReferenceLinks RiskAssessmentLegalReference[]

  @@index([siteId])
  @@index([workstationId])
}

/// Which status a single HazardCategory holds within one RiskAssessment —
/// the completeness axis an ASchG §4/§5 Evaluierung turns on
/// (SLD_IMPLEMENTATION_PLAN_hazards-and-environment.md §3.1). OPEN is the
/// only one never set by a human judgement: it's the explicit "not yet
/// assessed" state every category starts in, never inferred at read time
/// and never written by a backfill as anything else (§3.17, §8 "no inferred
/// completeness"). NOT_APPLICABLE and CHECKED_NO_HAZARD both require a
/// rationale (hand-added CHECK, below). HAZARD_PRESENT means at least one
/// RiskFinding of this category exists — kept in sync by a status-flip at
/// finding creation, never standing alone as a claim.
enum CategoryCheckStatus {
  NOT_APPLICABLE
  CHECKED_NO_HAZARD
  HAZARD_PRESENT
  OPEN
}

/// One row per (RiskAssessment, HazardCategory): the proof that EVERY hazard
/// type was considered, including "not present" and "not applicable", not
/// just the ones found present — the core legal deliverable of an
/// Evaluierung and the thing the completeness gate
/// (canSubmitForReview, src/lib/risk/category-check.ts) checks before a
/// DRAFT can move to IN_REVIEW
/// (SLD_IMPLEMENTATION_PLAN_hazards-and-environment.md §3.1).
///
/// Created explicitly — one OPEN row per HazardCategory in the same
/// transaction that creates the RiskAssessment — never inferred at read
/// time (§3.11 discipline, ERGO_COMPLIANCE_BY_DESIGN.md §3.17/§4).
///
/// `checkedByUserId`/`checkedAt` are nullable, and deliberately so: an OPEN
/// row (seeded on creation or backfilled onto a pre-existing assessment)
/// has no human behind its status yet, and claiming one would violate the
/// plan's "we didn't check, so we don't claim we did" rule. They're set
/// only when a human records a real NOT_APPLICABLE/CHECKED_NO_HAZARD/
/// HAZARD_PRESENT status via the checklist UI. `checkedByUserId` references
/// PlatformUser only (§3.13), a plain @db.Uuid column, not a DB-level FK —
/// same pattern as RiskAssessment.assessorUserId.
///
/// `rationale` is required (app + hand-added `HazardCategoryCheck_rationale_check`
/// CHECK, migration SQL, same technique as ManualInput_value_shape_check)
/// when status is NOT_APPLICABLE or CHECKED_NO_HAZARD — "nicht zutreffend"
/// and "geprüft, keine Gefährdung" are claims an inspector will read, so
/// they can't be made without a one-line reason.
model HazardCategoryCheck {
  id               String              @id @default(cuid())
  riskAssessmentId String
  category         HazardCategory
  status           CategoryCheckStatus
  rationale        String?
  checkedByUserId  String?             @db.Uuid
  checkedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Restrict, matching every other FK off RiskAssessment: completeness
  // rows can't be wiped out from under the assessment whose audit trail
  // they are.
  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Restrict)

  @@unique([riskAssessmentId, category])
  @@index([riskAssessmentId])
}

model RiskFinding {
  id                  String    @id @default(cuid())
  riskAssessmentId    String
  hazardId            String
  probability         Int
  severity            Int
  riskScore           Int
  riskBand            RiskBand
  existingControls    String?
  notes               String?
  residualProbability Int?
  residualSeverity    Int?
  residualRiskScore   Int?
  residualRiskBand    RiskBand?
  // P6 §6 step link: the specific Task (the "step") this finding relates to,
  // within the assessed workstation/process. Optional; validated to belong to
  // the assessment's own subject before being set (not merely same-site). No
  // new "step" entity — Task already means "a specific job at a workstation".
  taskId              String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  riskAssessment     RiskAssessment             @relation(fields: [riskAssessmentId], references: [id], onDelete: Restrict)
  hazard             Hazard                     @relation(fields: [hazardId], references: [id], onDelete: Restrict)
  task               Task?                      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  measurements       ExposureMeasurement[]
  actions            Action[]
  psychosocialDetail PsychosocialFindingDetail?
  substanceLinks     FindingSubstance[]

  @@index([riskAssessmentId])
  @@index([taskId])
}

/// Instrument or survey measurement supporting a finding, with the legal
/// limit(s) it is compared against recorded alongside it.
///
/// Deliberately NOT merged with ManualInput despite the similar shape:
/// ManualInput is task-level input feeding the CV scoring path, this is
/// environmental data supporting a risk finding. Same shape, different
/// lifecycle and consumer — do not "DRY" them together.
///
/// Two-tier (SLD_IMPLEMENTATION_PLAN_austria-first.md §4.4): Austrian
/// noise/vibration law sets both a lower "Auslösewert" (action value —
/// crossing it obliges the employer to plan measures) and a higher
/// "Expositionsgrenzwert" (exposure limit value — must never be
/// exceeded). `limitValue`/`limitReference` (pre-existing) are the
/// exposure-limit tier; `actionValue`/`actionValueReference` are the new
/// action-value tier. Both are free-editable fields, not a hard copy of
/// `exposureLimit`'s row — a human can still override them — but
/// `exposureLimitId`, when set, records *which* catalog row (and
/// therefore which country and which `ExposureLimitCatalogVersion`)
/// originally informed the prefill, the same "never recomputed against
/// whatever is active now" reasoning `RiskAssessment.matrixVersion`
/// already follows. Null when a measurement was entered fully manually
/// (no matching catalog row for this market/parameter yet, e.g. CHEMICAL
/// or a non-AT site) — the pre-existing free-text fallback, unchanged.
model ExposureMeasurement {
  id                   String   @id @default(cuid())
  riskFindingId        String
  value                Float
  unit                 String
  actionValue          Float?
  actionValueReference String?
  limitValue           Float?
  limitReference       String?
  exposureLimitId      String?
  instrument           String?
  method               String?
  measuredAt           DateTime
  notes                String?
  createdAt            DateTime @default(now())

  riskFinding   RiskFinding    @relation(fields: [riskFindingId], references: [id], onDelete: Restrict)
  // Restrict: a catalog row a real measurement points to for provenance
  // can't be deleted out from under it — matches every other FK in this
  // schema's "versioned data is never removed" discipline.
  exposureLimit ExposureLimit? @relation(fields: [exposureLimitId], references: [id], onDelete: Restrict)

  @@index([riskFindingId])
  @@index([exposureLimitId])
}

/// Tracks which ExposureLimit catalog vintage is "current," as real data
/// rather than a code constant — the exact same fail-closed,
/// single-active-version contract as MethodologyVersion/RiskMatrixVersion
/// (ERGO_COMPLIANCE_BY_DESIGN.md §3.14/§3.15). At most one row may have
/// isActive = true, enforced by a HAND-ADDED partial unique index in
/// migration SQL (`ExposureLimitCatalogVersion_isActive_unique_when_true`,
/// mirroring `MethodologyVersion_isActive_unique_when_true` exactly) since
/// Prisma's schema language can't express one. A lookup that finds zero
/// active rows must fail closed (throw), never silently fall back to
/// another version or another country's catalog.
model ExposureLimitCatalogVersion {
  version     String   @id
  label       String
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  limits ExposureLimit[]
}

/// Versioned, country-scoped catalogue of the LEGAL REFERENCES the risk
/// module cites per jurisdiction (SLD_RESTRUCTURE_PLAN_platform-modules.md
/// §4.2, ERGO_COMPLIANCE_BY_DESIGN.md §3.19) — e.g. ASchG §§4-5 for AT,
/// ArbSchG §§5-6 for DE, VUV/ArGV 3 for CH. Same fail-closed,
/// single-active-version contract as ExposureLimitCatalogVersion /
/// MethodologyVersion: at most one isActive = true (hand-added partial
/// unique index `LegalReferenceCatalogVersion_isActive_unique_when_true`),
/// zero active = misconfiguration that throws (getActiveLegalReferenceCatalog,
/// src/lib/country/legal-reference-catalog-version.ts). Nothing is seeded
/// into LegalReference until the founder has verified each row against the
/// official consolidated text (§3.19 / §4 never-build — the
/// SLD_P3_LEGAL_CATALOGUE_DRAFT.md worksheet is that gate).
model LegalReferenceCatalogVersion {
  version     String   @id
  label       String
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  references LegalReference[]
}

/// One legal reference for one topic in one country, under one catalogue
/// version. `topic` groups references by the §4.2 row type
/// (risk-assessment / instruction / expert-personnel / workplaces /
/// work-equipment / ppe / noise-vibration). The lookup
/// (lookupLegalReferences, src/lib/country/legal-reference-lookup.ts) filters
/// by country + topic and NEVER falls back to another country's reference
/// (§3.15) — a country with no row for a topic is an honest gap. `sourceUrl`
/// + `consolidatedVersion` + `verifiedBy`/`verifiedAt` are the verification
/// provenance: a reference exists in the catalogue only because a named human
/// confirmed it against the official consolidated text on a given date.
/// `verifiedBy`/`verifiedAt`/`sourceUrl`/`code`/`obligation`/`topic` are all
/// required — there is no such thing as an unverified or sourceless row here.
model LegalReference {
  id                  String      @id @default(cuid())
  catalogVersion      String
  country             CountryCode
  topic               String
  code                String
  obligation          String
  sourceUrl           String
  consolidatedVersion String?
  verifiedBy          String
  verifiedAt          DateTime
  // How this row was verified (approved worksheet §2): "official" = Stand read
  // from the official portal, "mirror" = paragraph + version confirmed via a
  // consolidated-text mirror citing the official source, "seed-check" =
  // resolved to "official" at seed time by reading the Stand off the official
  // page (a row that could not be read is skipped, never seeded). Founder-
  // approved delegated verification per ERGO_COMPLIANCE_BY_DESIGN.md §3.19.
  verificationMethod  String
  notes               String?
  createdAt           DateTime    @default(now())

  catalog         LegalReferenceCatalogVersion   @relation(fields: [catalogVersion], references: [version], onDelete: Restrict)
  assessmentLinks RiskAssessmentLegalReference[]

  @@unique([catalogVersion, country, code])
  @@index([catalogVersion, country, topic])
}

// P6 §6: the "applicable legal references" an assessor marks on a specific
// RiskAssessment, chosen from the country catalogue. A curated subset — the
// catalogue says what law exists for the market; this says which rows the
// assessor considers applicable to THIS assessment. Both FKs Restrict (§3.9).
model RiskAssessmentLegalReference {
  id               String   @id @default(cuid())
  riskAssessmentId String
  legalReferenceId String
  createdAt        DateTime @default(now())

  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Restrict)
  legalReference LegalReference @relation(fields: [legalReferenceId], references: [id], onDelete: Restrict)

  @@unique([riskAssessmentId, legalReferenceId])
  @@index([riskAssessmentId])
  @@index([legalReferenceId])
}

/// One legal exposure limit for one parameter in one country, under one
/// catalog version (SLD_IMPLEMENTATION_PLAN_austria-first.md §4.5).
/// `actionValue`/`limitValue` are BOTH nullable, independently — a row
/// with both null and only `legalReference` set is a legitimate,
/// deliberately-modeled state meaning "the law requires this to be
/// evaluated but sets no single number" (e.g. ERGONOMIC_MSD, or CHEMICAL
/// where MAK/TRK values are substance-specific, not one figure). The UI
/// must render that as an obligation, not as a blank row.
///
/// `country` + `hazardCategory` + `parameterKey` is the lookup key
/// (`lookupExposureLimits`, src/lib/risk/exposure-limit-lookup.ts) —
/// never resolved with a fallback to a different country's row for the
/// same parameter (ERGO_COMPLIANCE_BY_DESIGN.md §3.15/§4 — showing a
/// German or generic number to an Austrian customer is a defect, not a
/// rounding error).
model ExposureLimit {
  id                String         @id @default(cuid())
  catalogVersion    String
  country           CountryCode
  hazardCategory    HazardCategory
  parameterKey      String
  parameterLabel    String
  unit              String
  actionValue       Float?
  limitValue        Float?
  legalReference    String
  legalReferenceUrl String?
  notes             String?
  createdAt         DateTime       @default(now())

  catalog      ExposureLimitCatalogVersion @relation(fields: [catalogVersion], references: [version], onDelete: Restrict)
  measurements ExposureMeasurement[]

  @@unique([catalogVersion, country, parameterKey])
  @@index([catalogVersion, country, hazardCategory])
}

/// The four dimensions Austrian guidance uses for evaluating
/// arbeitsbedingte psychische Belastungen (aligned to ÖNORM EN ISO
/// 10075-1/-3), SLD_IMPLEMENTATION_PLAN_austria-first.md §7 B7. A closed,
/// structural set the SGD reports on systematically — deliberately a real
/// enum, not four Hazard catalog rows a company_admin could rename or
/// delete (see PsychosocialFindingDetail below).
enum PsychosocialDimension {
  /// Arbeitsaufgabe und Tätigkeit
  TASK_AND_ACTIVITY
  /// Arbeitsorganisation und Arbeitsabläufe
  WORK_ORGANIZATION
  /// Arbeitsumgebung
  WORK_ENVIRONMENT
  /// Sozial- und Organisationsklima
  SOCIAL_CLIMATE
}

/// How a psychosocial finding's band was derived — recorded because the
/// Arbeitsinspektion asks, and because it gates the group-size CHECK below
/// (§7 B7: questionnaire instruments are unsuitable below 15 employees;
/// smaller groups use one of the other three methods instead).
enum PsychosocialMethod {
  QUESTIONNAIRE
  GROUP_DISCUSSION
  OBSERVATION
  INTERVIEW
}

/// Structured detail for a PSYCHOSOCIAL-category RiskFinding
/// (SLD_IMPLEMENTATION_PLAN_austria-first.md §7 B7) — "structured
/// findings, not a survey platform." One row per RiskFinding (1:1, see
/// the unique riskFindingId), same "related table rather than nullable
/// columns bolted onto RiskFinding" shape ExposureMeasurement already
/// uses for its own hazard-category-specific detail.
///
/// Deliberately absent from this model, permanently, per
/// ERGO_COMPLIANCE_BY_DESIGN.md §3.12/§4 and the locked decision recorded
/// there: any per-respondent field, any free-text verbatim response
/// field, any table keyed by an individual. `groupSize` is an aggregate
/// headcount the finding covers, never a link to who was in it.
/// `externalProcedureName` records *that* a named external Verfahren
/// (e.g. COPSOQ, AVEM) was used, never its raw responses — the
/// finding's own riskBand/notes (on RiskFinding) are what it concluded.
///
/// The group-size floor is real but conditional, not a blanket "always
/// ≥15": Austrian guidance (WKO/Arbeitsinspektion) says QUESTIONNAIRE
/// instruments specifically are unsuitable below 15 employees because
/// anonymity can't be preserved at that scale, and directs smaller
/// operations toward GROUP_DISCUSSION/OBSERVATION/INTERVIEW instead — so
/// the hand-added CHECK
/// (`PsychosocialFindingDetail_group_size_check`) only enforces the
/// floor when method = QUESTIONNAIRE.
model PsychosocialFindingDetail {
  id                    String                @id @default(cuid())
  riskFindingId         String                @unique
  dimension             PsychosocialDimension
  method                PsychosocialMethod
  groupSize             Int
  externalProcedureName String?
  createdAt             DateTime              @default(now())

  // Restrict: a psychosocial finding's structured detail can't be
  // deleted out from under the finding it describes — same discipline
  // as every other FK in this schema.
  riskFinding RiskFinding @relation(fields: [riskFindingId], references: [id], onDelete: Restrict)

  @@index([riskFindingId])
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
  CANCELLED
}

enum HierarchyOfControl {
  ELIMINATION
  SUBSTITUTION
  ENGINEERING_CONTROL
  ADMINISTRATIVE_CONTROL
  PPE
}

enum VerificationOutcome {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  NOT_EFFECTIVE
}

/// A corrective action from a risk finding, an ergonomic assessment
/// session, or (E1, option b) an environmental finding — exactly one
/// source, HAND-ADDED CHECK in migration SQL (updated to an exactly-one-of-
/// three check when environmentalFindingId was added). Ergonomic findings
/// roll up to their AssessmentSession rather than to an individual
/// BodyRegionScore — keeps the CHECK simple and matches how an EHS manager
/// actually raises an action ("this workstation's assessment found X"), not
/// per-joint.
///
/// `environmentalMeasureType` (nullable) is the environmental-domain
/// counterpart to `hierarchyOfControl` — AVOID/REDUCE/REUSE/... per ISO
/// 14001's mitigation hierarchy — set instead of hierarchyOfControl when
/// the action comes from an environmental finding. The two domains never
/// share one artifact (§3.17), so an action carries whichever one fits its
/// source; the pairing is enforced in the lib/UI layer (E3), the DB CHECK
/// here only guarantees exactly one source.
///
/// responsibleUserId references PlatformUser only (§3.13). Where the owner
/// is a function rather than an account, use responsibleRoleLabel — a role,
/// never a person's name.
model Action {
  id                       String                    @id @default(cuid())
  siteId                   String
  riskFindingId            String?
  assessmentSessionId      String?
  environmentalFindingId   String?
  inspectionObservationId  String?
  title                    String
  description              String?
  hierarchyOfControl       HierarchyOfControl?
  environmentalMeasureType EnvironmentalMeasureType?
  responsibleUserId        String?                   @db.Uuid
  responsibleRoleLabel     String?
  // P6 §6: when an action was started from a TypicalMeasure suggestion, record
  // which one — provenance survives the assessor editing the title, and lets a
  // later "suggested vs. custom" report run with no person data. Nullable FK.
  typicalMeasureId         String?
  dueDate                  DateTime?
  status                   ActionStatus              @default(OPEN)
  implementedAt            DateTime?
  verifiedAt               DateTime?
  verifiedByUserId         String?                   @db.Uuid
  verificationOutcome      VerificationOutcome?
  verificationAssessmentId String?
  verificationNote         String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  site                   Site                   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  riskFinding            RiskFinding?           @relation(fields: [riskFindingId], references: [id], onDelete: Restrict)
  assessmentSession      AssessmentSession?     @relation(fields: [assessmentSessionId], references: [id], onDelete: Restrict)
  environmentalFinding   EnvironmentalFinding?  @relation(fields: [environmentalFindingId], references: [id], onDelete: Restrict)
  inspectionObservation  InspectionObservation? @relation(fields: [inspectionObservationId], references: [id], onDelete: Restrict)
  verificationAssessment RiskAssessment?        @relation("ActionVerificationAssessment", fields: [verificationAssessmentId], references: [id], onDelete: Restrict)
  typicalMeasure         TypicalMeasure?        @relation(fields: [typicalMeasureId], references: [id], onDelete: Restrict)
  statusEvents           ActionStatusEvent[]

  @@index([siteId, status])
  @@index([riskFindingId])
}

/// Append-only status history (§3.6). Never updated, never deleted.
model ActionStatusEvent {
  id         String        @id @default(cuid())
  actionId   String
  fromStatus ActionStatus?
  toStatus   ActionStatus
  byUserId   String        @db.Uuid
  note       String?
  createdAt  DateTime      @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([actionId])
}

/// An uploaded floor-plan image for a site (e.g. "Hall 2", "Ground floor").
/// `storagePath` points at the actual image in Supabase Storage; `width`/
/// `height` are the pixel dimensions of that image, which is what the
/// normalized 0..1 coordinates on WorkstationPlanPosition/TaskPlanPosition
/// are relative to.
model FloorPlan {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  storagePath String
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict, matching every other relation off Site: a site's floor plans
  // can't be wiped out as a side effect of deleting the site.
  site                     Site                      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workstationPlanPositions WorkstationPlanPosition[]
  taskPlanPositions        TaskPlanPosition[]

  @@index([siteId])
}

/// A workstation is an area, not a point — a "packaging station" might span
/// a pallet pickup spot, a wrapping table, and a stacking area meters apart.
/// This is the fallback/aggregate pin shown on a floor plan when nobody has
/// placed the workstation's individual tasks yet (see TaskPlanPosition,
/// which is the finer-grained pin a heatmap actually wants). A workstation
/// appears at most once per plan.
model WorkstationPlanPosition {
  id            String @id @default(cuid())
  floorPlanId   String
  workstationId String
  x             Float
  y             Float

  // Cascade both ways: a pin is meaningless without the plan it's placed
  // on, and a workstation's map pin has no reason to outlive the
  // workstation — unlike the assessment chain above, there's no audit
  // trail value in keeping an orphaned pin around.
  floorPlan   FloorPlan   @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  workstation Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, workstationId])
  @@index([floorPlanId])
}

/// Task-level pin on a floor plan. PostureSample already belongs to Task,
/// not Workstation, so this is the pin granularity a movement heatmap
/// actually needs — it can point at exactly which spot within a
/// workstation drives risk, rather than only the workstation as a whole.
/// A task appears at most once per plan.
model TaskPlanPosition {
  id          String @id @default(cuid())
  floorPlanId String
  taskId      String
  x           Float
  y           Float

  // Cascade both ways, same reasoning as WorkstationPlanPosition.
  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, taskId])
  @@index([floorPlanId])
}

// ---------------------------------------------------------------------------
// Environment module ("Umweltaspekte") — E1 of
// SLD_IMPLEMENTATION_PLAN_hazards-and-environment.md §5, built as a SEPARATE
// domain (option b): EnvironmentalAssessment / EnvironmentalFinding are their
// own models, RiskFinding is untouched, so the worker-safety side (the
// Evaluierung and the SGD) carries no risk from this still-experimental
// module (ERGO_COMPLIANCE_BY_DESIGN.md §3.17). The two domains REUSE the loop
// — RiskMatrixVersion for significance, RiskBand/RiskAssessmentStatus/
// CategoryCheckStatus for vocabulary, the same Action + IMPLEMENTED→VERIFIED
// flow — but never share one artifact (no environmental row in the SGD, no
// worker-protection row in the AWK). Environmental data names no person
// (§3.17): waste contractors are companies, responsibilities are
// PlatformUser accounts or role labels.
// ---------------------------------------------------------------------------

/// The environmental aspect categories (ISO 14001 §6.1.2), deliberately a
/// SEPARATE enum from HazardCategory — "Abwasser"/"Energie" are not worker-
/// protection hazards and must never leak into the SGD, the worker briefing,
/// the psychosocial rules or the AT limit catalogue (§3.17, §5.1).
enum EnvironmentalAspectCategory {
  AIR_EMISSIONS
  ENERGY_USE
  WATER_USE
  WASTEWATER
  WASTE_NON_HAZARDOUS
  WASTE_HAZARDOUS
  RAW_MATERIALS
  HAZARDOUS_SUBSTANCES
  SOIL_GROUNDWATER
  NOISE_NEIGHBOURHOOD
  ODOUR
  LIGHT_EMISSIONS
  TRANSPORT_LOGISTICS
  BIODIVERSITY_LAND_USE
}

/// ISO 14001 requires aspects to be evaluated across all three operating
/// conditions — normal, abnormal (start-up/shutdown/maintenance) and
/// reasonably foreseeable emergency.
enum OperatingCondition {
  NORMAL
  ABNORMAL
  EMERGENCY
}

/// The environmental mitigation hierarchy (§5.2) — the environmental-domain
/// counterpart to HierarchyOfControl, used on an Action sourced from an
/// EnvironmentalFinding.
enum EnvironmentalMeasureType {
  AVOID
  REDUCE
  REUSE
  RECYCLE
  RECOVER
  DISPOSE_SAFELY
  SUBSTITUTE
  TECHNICAL
  ORGANISATIONAL
  MONITORING
}

/// Environmental aspect catalogue, mirroring Hazard exactly: companyId ==
/// null = system catalogue (seeded, shared, super_admin-only to write);
/// companyId set = a company's own additions.
model EnvironmentalAspect {
  id          String                      @id @default(cuid())
  companyId   String?
  category    EnvironmentalAspectCategory
  code        String
  name        String
  description String?
  isSystem    Boolean                     @default(false)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  company    Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  findings   EnvironmentalFinding[]
  substances Substance[]

  @@index([companyId, category])
}

/// A dated environmental assessment — the ISO 14001 §6.1.2 counterpart of
/// RiskAssessment, kept as its own model (option b). Belongs to a Site and
/// may optionally narrow to a Workstation (a site-level assessment, e.g. a
/// boiler house or wastewater plant, is the common case — §5.2, so no
/// exactly-one-subject constraint). Reuses RiskMatrixVersion for
/// significance and RiskAssessmentStatus for the DRAFT→IN_REVIEW→APPROVED
/// flow. assessorUserId/approvedByUserId reference PlatformUser only
/// (@db.Uuid, no DB-level FK), same as RiskAssessment.
model EnvironmentalAssessment {
  id                String               @id @default(cuid())
  siteId            String
  workstationId     String?
  matrixVersion     String
  status            RiskAssessmentStatus @default(DRAFT)
  assessorUserId    String               @db.Uuid
  approvedByUserId  String?              @db.Uuid
  assessedAt        DateTime
  approvedAt        DateTime?
  pilotContext      String?
  notes             String?
  // E4 (§6): AWG 2002 §10 Abs. 3 Z5 — "estimate of future development." Free
  // text the assessor maintains; rendered as the AWK's item-5 section.
  futureDevelopment String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  site           Site                         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workstation    Workstation?                 @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  matrix         RiskMatrixVersion            @relation(fields: [matrixVersion], references: [version], onDelete: Restrict)
  findings       EnvironmentalFinding[]
  categoryChecks EnvironmentalCategoryCheck[]

  @@index([siteId])
  @@index([workstationId])
}

/// A single environmental finding (aspect + its significance), the
/// counterpart of RiskFinding. `operatingCondition` is required (unlike the
/// nullable-for-OSH framing of the merged-model plan, a separate model lets
/// it simply be NOT NULL). `legallyRelevant` marks an aspect tied to a
/// binding obligation (ISO 14001 §6.1.3). `significant` is stored at write
/// time (computeEnvironmentalSignificance) for traceability — band ∈
/// {ELEVATED, HIGH} OR legallyRelevant — never re-derived at read time.
model EnvironmentalFinding {
  id                        String             @id @default(cuid())
  environmentalAssessmentId String
  environmentalAspectId     String
  probability               Int
  severity                  Int
  riskScore                 Int
  riskBand                  RiskBand
  operatingCondition        OperatingCondition
  legallyRelevant           Boolean            @default(false)
  significant               Boolean
  existingControls          String?
  notes                     String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  environmentalAssessment EnvironmentalAssessment @relation(fields: [environmentalAssessmentId], references: [id], onDelete: Restrict)
  aspect                  EnvironmentalAspect     @relation(fields: [environmentalAspectId], references: [id], onDelete: Restrict)
  actions                 Action[]
  quantities              EnvironmentalQuantity[]
  wasteStreams            WasteStream[]

  @@index([environmentalAssessmentId])
}

/// The environmental completeness checklist — a copy of HazardCategoryCheck
/// (§5.2: "Build H1 so that this is a copy, not a rewrite"), keyed on
/// EnvironmentalAspectCategory and FK'd to EnvironmentalAssessment. Same
/// CategoryCheckStatus, same rationale CHECK, same "OPEN until a human sets
/// it, never inferred" discipline (§8).
model EnvironmentalCategoryCheck {
  id                        String                      @id @default(cuid())
  environmentalAssessmentId String
  category                  EnvironmentalAspectCategory
  status                    CategoryCheckStatus
  rationale                 String?
  checkedByUserId           String?                     @db.Uuid
  checkedAt                 DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  environmentalAssessment EnvironmentalAssessment @relation(fields: [environmentalAssessmentId], references: [id], onDelete: Restrict)

  @@unique([environmentalAssessmentId, category])
  @@index([environmentalAssessmentId])
}

/// A measured or estimated quantity supporting an environmental finding (E2,
/// SLD_IMPLEMENTATION_PLAN_hazards-and-environment.md §5.3) — the
/// environmental counterpart of ExposureMeasurement, over a period. `source`
/// ("Zählerstand"/"Rechnung"/"Schätzung") and `isEstimate` are the
/// provenance discipline (§3.16 analogue): an estimate must always be
/// labelled as such in the UI and in the AWK, never shown as a measured
/// value. No CO₂ conversion here (§5.3: that needs a versioned, sourced
/// emission-factor catalogue — E4/E5, not this).
model EnvironmentalQuantity {
  id                     String   @id @default(cuid())
  environmentalFindingId String
  value                  Float
  unit                   String
  periodStart            DateTime
  periodEnd              DateTime
  source                 String
  isEstimate             Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())

  environmentalFinding EnvironmentalFinding @relation(fields: [environmentalFindingId], references: [id], onDelete: Restrict)

  @@index([environmentalFindingId])
}

/// A waste stream at a site (E2, §5.3) — the raw material for the Austrian
/// Abfallwirtschaftskonzept (E4). `wasteCode` is free text (AT:
/// Schlüsselnummer per Abfallverzeichnisverordnung / ÖNORM S 2100) — entered
/// by the assessor, never a seeded legal value (§3.17 — no unverified legal
/// content baked in). `collectorCompany` (Entsorger) is a company name, never
/// a person (§3.17). Optionally linked to its originating workstation/process
/// and to the WASTE_* environmental finding it supports; all nullable, since
/// a waste register can be kept at site level before any finding exists.
model WasteStream {
  id                     String   @id @default(cuid())
  siteId                 String
  wasteCode              String
  name                   String
  hazardous              Boolean  @default(false)
  originWorkstationId    String?
  originProcessId        String?
  environmentalFindingId String?
  annualQuantity         Float?
  unit                   String?
  collectorCompany       String?
  treatment              String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  site                 Site                  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  originWorkstation    Workstation?          @relation(fields: [originWorkstationId], references: [id], onDelete: Restrict)
  originProcess        Process?              @relation(fields: [originProcessId], references: [id], onDelete: Restrict)
  environmentalFinding EnvironmentalFinding? @relation(fields: [environmentalFindingId], references: [id], onDelete: Restrict)
  substances           Substance[]

  @@index([siteId])
  @@index([environmentalFindingId])
}

// ---------------------------------------------------------------------------
// Platform foundation (SLD_RESTRUCTURE_PLAN_platform-modules.md P1, §2.4).
// The module registry (src/lib/modules/registry.ts) is the single code source
// for the sidebar, route guards and entitlement; CompanyModule is the data
// side of entitlement. AuditEvent is the one global audit log every regulated
// module writes through (ERGO_COMPLIANCE_BY_DESIGN.md §3.18, plan §2.2 rule 9).
// Neither table touches the assessment chain or holds person data; actor is a
// PlatformUser account id only (§3.1/§3.13), never a shop-floor worker.
// ---------------------------------------------------------------------------

/// Stable module keys — the code, route and entitlement identity for each
/// platform module (SLD_RESTRUCTURE_PLAN_platform-modules.md §2.1). Labels
/// are i18n/country-pack, never stored here. Adding a module is an enum
/// value here plus a registry entry; cockpit/my-tasks/actions/documents/
/// reports/settings are the baseline modules that never require an
/// entitlement (see ModuleDefinition.requiresEntitlement).
enum ModuleKey {
  COCKPIT
  MY_TASKS
  RISK
  INSPECTIONS
  INCIDENTS
  ENVIRONMENT
  ACTIONS
  CHEMICALS
  TRAINING
  PEOPLE
  LEGAL
  DOCUMENTS
  REPORTS
  SETTINGS
}

/// Per-company module entitlement (SLD_RESTRUCTURE_PLAN_platform-modules.md
/// §2.4): a row means "this company has this module turned on." Written only
/// by super_admin (enforced at the app layer — isModuleEnabled/enableModule
/// in src/lib/modules/entitlement.ts; RLS enabled with no policy, same
/// owner-bypass posture as every other table until the non-owner runtime
/// role lands). A module whose `requiresEntitlement` is false in the registry
/// never needs a row here. `enabledByUserId` references PlatformUser only, a
/// plain @db.Uuid column not a DB-level FK — same pattern as
/// RiskAssessment.assessorUserId (§3.13).
model CompanyModule {
  id              String    @id @default(cuid())
  companyId       String
  moduleKey       ModuleKey
  enabledAt       DateTime  @default(now())
  enabledByUserId String?   @db.Uuid

  // Restrict: entitlement rows can't be wiped out from under a company by an
  // accidental cascade — offboarding is a deliberate, logged action (§3.9).
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, moduleKey])
  @@index([companyId])
}

/// Global append-only audit log (ERGO_COMPLIANCE_BY_DESIGN.md §3.18(d), plan
/// §2.2 rule 9). One helper (recordAuditEvent, src/lib/audit/audit-event.ts)
/// writes a row from every mutation in the regulated modules (incidents,
/// people, training proof, approvals) and from every health-compartment read.
/// Append-only by design: there is no update/delete helper, and the audit log
/// deliberately OUTLIVES the entity it describes — `siteId`/`companyId`/
/// `entityId` are plain columns, NOT foreign keys, so the record of a
/// deletion survives the deletion. `actorUserId` references a PlatformUser
/// account only (§3.1/§3.13), nullable for system/anonymous actions; it is
/// never a shop-floor worker. `diff` holds a before/after of regulated fields
/// only, never raw health free-text (that stays in the encrypted health
/// sub-compartment). `ipHash` is a hash, never a raw IP.
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  companyId   String?
  siteId      String?
  diff        Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([siteId])
  @@index([actorUserId])
}

/// Document layer, part 1 (SLD_RESTRUCTURE_PLAN_platform-modules.md §2.2 rule
/// 4, §7.2): every generated document is archived — a durable record of what
/// was issued, when, by whom, from which methodology/matrix/catalogue
/// versions, with its SHA-256 and storage path. Regeneration never overwrites:
/// genuinely different output (new sha256) is a new row; identical content for
/// the same (site, type) is deduplicated via the unique index. Bytes live in
/// the private "generated-documents" Supabase bucket (src/lib/storage/
/// generated-document.ts), read only via short-lived signed URLs.
/// `generatedByUserId` references a PlatformUser account only (§3.13), never a
/// worker; it is nullable so an archive row survives the user's removal.
enum GeneratedDocumentType {
  TASK_REPORT
  RISK_ASSESSMENT_REPORT
  WORKER_BRIEFING
  SGD
  AWK
  BETRIEBSANWEISUNG
  GEFAHRSTOFFVERZEICHNIS
}

model GeneratedDocument {
  id                String                @id @default(cuid())
  type              GeneratedDocumentType
  companyId         String
  siteId            String
  /// Human display label for the document's scope (e.g. the workstation or
  /// task name), presentation-agnostic — no per-subject FK zoo.
  title             String
  country           CountryCode
  generatedByUserId String?               @db.Uuid
  generatedAt       DateTime              @default(now())
  /// The methodology/matrix/legal-catalogue versions in force at generation,
  /// as a small JSON object — provenance, never recomputed later.
  versions          Json?
  sha256            String
  storagePath       String
  fileSize          Int

  // Restrict: an archived document can't be orphaned by deleting its site out
  // from under it — offboarding is deliberate (§3.9).
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([siteId, type, sha256])
  @@index([siteId, type])
  @@index([companyId])
}

/// Document layer, part 2 (SLD_RESTRUCTURE_PLAN_platform-modules.md §2.2 rule
/// 3, §7.2): the uploads library. A Document is site-scoped (§2.2 rule 1 — it
/// hangs off a Site) and categorised; its content lives in versioned
/// DocumentVersion rows (new upload = new version, old versions kept). Bytes
/// go to the private "documents" Supabase bucket after passing the upload
/// safety gate (src/lib/storage/malware-scan.ts: allowlist + EICAR + optional
/// engine). `createdByUserId`/`uploadedByUserId` reference PlatformUser
/// accounts only (§3.13), nullable so a row survives the user's removal.
///
/// Deferred to their own passes (not stringly-typed when they land): per-record
/// DocumentLink (one nullable FK per linkable type + exactly-one CHECK, §2.2
/// rule 3) and read-confirmation campaigns (need the Person register, P7).
enum DocumentCategory {
  PROCEDURE
  PERMIT
  CERTIFICATE
  SDS
  INSPECTION_EVIDENCE
  TRAINING_MATERIAL
  EXTERNAL_REPORT
  AUTHORITY_CORRESPONDENCE
  OTHER
}

model Document {
  id              String           @id @default(cuid())
  companyId       String
  siteId          String
  category        DocumentCategory
  title           String
  reviewDueDate   DateTime?
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Restrict: a document library can't be wiped out by deleting its site —
  // offboarding is deliberate (§3.9).
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[]
  safetyDataSheets SafetyDataSheet[]

  @@index([siteId, category])
  @@index([companyId])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  version          Int
  fileName         String
  mimeType         String
  fileSize         Int
  sha256           String
  storagePath      String
  uploadedByUserId String?  @db.Uuid
  uploadedAt       DateTime @default(now())
  notes            String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
  @@index([documentId])
}

// P6 §6: whether the assessed activity is routine or non-routine (§2 Z 7
// ASchG-style distinction). Nullable on RiskAssessment — legacy rows and
// in-progress drafts legitimately have no value yet.
enum ActivityType {
  ROUTINE
  NON_ROUTINE
}

// P5 notifications service (SLD_RESTRUCTURE_PLAN_platform-modules.md §7.9).
// The event vocabulary. Only the first five have a generator in v1 (their
// recipient is unambiguous in today's data — see src/lib/notifications/
// generate.ts); the rest are reserved enum values with no generator yet,
// the same forward-declaration discipline AssessmentMode.CONTINUOUS and
// PostureSampleSource.IMPORTED_MODEL already follow. A notification NEVER
// describes an individual's behaviour or health (ERGO_COMPLIANCE_BY_DESIGN.md
// §3.18, plan §6 "never let a notification describe an individual").
enum NotificationEventType {
  ACTION_DUE_SOON
  ACTION_OVERDUE
  ACTION_VERIFICATION_DUE
  DOCUMENT_REVIEW_DUE
  ASSESSMENT_REVIEW_DUE
  // Reserved — land with their modules (P6–P12), no generator yet.
  ENVIRONMENTAL_ASSESSMENT_REVIEW_DUE
  INSPECTION_DUE
  INCIDENT_REPORTED
  NOTIFICATION_DEADLINE_APPROACHING
  SDS_OUTDATED
  INSTRUCTION_DUE
  INSTRUCTION_OVERDUE
  LEGAL_REQUIREMENT_REVIEW_DUE
}

// A single in-app notification instance for one recipient. Like AuditEvent,
// it carries recipientUserId/companyId/siteId/subjectId as PLAIN columns
// (no FKs) so it outlives the entities it points at and never cascades.
// recipientUserId is a PlatformUser account id (logs in) — never a Person
// (§3.18(4)). dedupeKey makes generation idempotent: re-running the generator
// upserts on (recipientUserId, dedupeKey) instead of piling up duplicates.
model Notification {
  id              String                @id @default(cuid())
  recipientUserId String                @db.Uuid
  eventType       NotificationEventType
  companyId       String?
  siteId          String?
  // What it points at (e.g. "Action", "Document", "RiskAssessment") + id,
  // plain columns, and the in-app deep link the inbox renders.
  subjectType     String?
  subjectId       String?
  href            String
  title           String
  body            String
  // The due date the event is about (for sorting the inbox); null for
  // events with no date dimension.
  dueAt           DateTime?
  dedupeKey       String
  readAt          DateTime?
  // Best-effort email dispatch stamp (null = not sent / no provider).
  emailedAt       DateTime?
  createdAt       DateTime              @default(now())

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId, readAt])
  @@index([siteId])
}

// P6 §6 typical measures (SLD_P6_TYPICAL_MEASURES_APPROVED.md). Founder-worded
// good-practice measure suggestions, offered when raising an Action from a
// finding — never auto-created. Versioned the same fail-closed way as every
// other catalogue (single active row; hand-added partial unique index on
// isActive in the migration, which Prisma's schema can't express).
model TypicalMeasureCatalogVersion {
  version     String   @id
  label       String
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  measures TypicalMeasure[]
}

model TypicalMeasure {
  id                 String             @id @default(cuid())
  catalogVersion     String
  hazardCategory     HazardCategory
  // Null = applies to the whole category; a system Hazard.code narrows it to a
  // specific hazard (none seeded with a code in v1 — the column exists so
  // hazard-specific measures can be added later without a migration).
  hazardCode         String?
  hierarchyOfControl HierarchyOfControl
  measureDe          String
  measureEn          String?
  order              Int
  notes              String?
  createdAt          DateTime           @default(now())

  catalog TypicalMeasureCatalogVersion @relation(fields: [catalogVersion], references: [version], onDelete: Restrict)
  actions Action[]

  @@index([catalogVersion, hazardCategory])
}

// P7 people compartment (SLD_P7_COMPARTMENT_DESIGN_NOTE.md, plan §3.2). The
// FIRST person data in the product. Deliberately FK-free into shared/
// assessment tables: companyId is the only FK (tenant root); orgUnitId /
// workstationId / platformUserId are PLAIN columns (no relation), so the
// compartment physically cannot couple to the person-free assessment chain in
// either direction (the §3.18(a) reverse-assertion in compartment-schema.test
// stays absolute, no carve-out) — same discipline as AuditEvent/Notification.
// Field set is exactly §3.2: NO date of birth, address, nationality, gender,
// health or performance data — never add one without a documented statutory
// reason (ERGO §3.18 never-build).
model Person {
  id                   String    @id @default(cuid())
  companyId            String
  firstName            String
  lastName             String
  personnelNumber      String?
  // Home org unit — plain column, validated via the subject helper, never a FK.
  orgUnitId            String?
  employmentStart      DateTime?
  employmentEnd        DateTime?
  active               Boolean   @default(true)
  // Optional one-way self-service link to a login account (§3 note) — plain
  // @db.Uuid, never a FK, same as Action.responsibleUserId.
  platformUserId       String?   @db.Uuid
  // Set by the anonymisation workflow (§3.2 / §6 of the design note); name and
  // personnel number are scrubbed, the row (and any proof rows) survive.
  anonymisedAt         DateTime?
  // P7d §C.4 legal hold: excludes the person and all linked records from every
  // retention/anonymisation batch until cleared.
  legalHold            Boolean   @default(false)
  legalHoldReason      String?
  legalHoldSetByUserId String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments     PersonAssignment[]
  trainingRecords TrainingRecord[]

  @@index([companyId])
}

// person ↔ workstation OR org unit (hand-added exactly-one CHECK), with
// validity dates. Exists ONLY to derive instruction requirements (§3.2): never
// shown on an assessment screen, never in a risk report. workstationId /
// orgUnitId are plain columns (no FK, see Person above).
model PersonAssignment {
  id            String    @id @default(cuid())
  personId      String
  workstationId String?
  orgUnitId     String?
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
}

// P7c Unterweisungen / training (SLD_P7_COMPARTMENT_DESIGN_NOTE.md, plan §7.6).
// People-compartment tables — proof of instruction. Like the rest of the
// compartment they hold no FK into the assessment chain (legalReferenceId is
// a plain column; requirement SOURCES that point at a workstation/process/
// finding land in P7c-2 as loose subjectType+subjectId, never a relation).
enum TrainingDeliveryMethod {
  IN_PERSON
  ELEARNING
  DOCUMENT_READ_CONFIRMATION
}

enum TrainingConfirmation {
  SIGNATURE
  SELF_CONFIRMED
}

model TrainingRequirementType {
  id               String                 @id @default(cuid())
  companyId        String?
  title            String
  contentOutline   String?
  recurrenceMonths Int?
  // Plain column (no FK) into the P3 LegalReference catalogue — keeps the
  // training compartment FK-light, same discipline as Person.orgUnitId.
  legalReferenceId String?
  deliveryMethod   TrainingDeliveryMethod
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  sessions                 TrainingSession[]
  records                  TrainingRecord[]
  sources                  TrainingRequirementSource[]
  retentionOverride        String?
  retentionOverrideTrigger RetentionTrigger?

  @@index([companyId])
}

model TrainingSession {
  id                String   @id @default(cuid())
  companyId         String
  requirementTypeId String
  date              DateTime
  instructor        String
  topics            String?
  notes             String?
  createdAt         DateTime @default(now())

  requirementType TrainingRequirementType @relation(fields: [requirementTypeId], references: [id], onDelete: Restrict)
  records         TrainingRecord[]

  @@index([companyId])
  @@index([requirementTypeId])
}

model TrainingRecord {
  id                String                 @id @default(cuid())
  personId          String
  requirementTypeId String
  trainingSessionId String?
  completedAt       DateTime
  method            TrainingDeliveryMethod
  confirmation      TrainingConfirmation
  validUntil        DateTime?
  createdAt         DateTime               @default(now())

  person          Person                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  requirementType TrainingRequirementType @relation(fields: [requirementTypeId], references: [id], onDelete: Restrict)
  trainingSession TrainingSession?        @relation(fields: [trainingSessionId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([requirementTypeId])
}

// P7d §B.1 (SLD_P7B_DEFERRALS_RESOLVED.md): role = bundle of permissions,
// granted to a PlatformUser at a scope. Replaces the implicit role→scope
// mapping (the legacy 4 roles are backfilled into rows with no change in
// effective access; SiteAssignment stays readable during the transition).
// Append-only in spirit: revoking sets revokedAt, never deletes. scopeId is
// a plain column (points at Site/OrgUnit/Person depending on scopeType) — no
// FK, same cross-cutting discipline as AuditEvent. A hand-added CHECK enforces
// scopeId nullability by scopeType.
model RoleAssignment {
  id              String       @id @default(cuid())
  platformUserId  String       @db.Uuid
  role            PlatformRole
  scopeType       ScopeType
  scopeId         String?
  grantedByUserId String?      @db.Uuid
  grantedAt       DateTime     @default(now())
  revokedAt       DateTime?

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([scopeType, scopeId])
}

// P7d §A.2 (SLD_P7B_DEFERRALS_RESOLVED.md): how a TrainingRequirementType
// becomes required — attached to a job-level subject. subjectId is a plain
// column (loose subjectType+subjectId, no FK, per §D1) so the training
// compartment never couples to the assessment chain. SUBSTANCE is reserved
// (no derivation until P8).
enum RequirementSourceType {
  WORKSTATION
  ORG_UNIT
  PROCESS
  SUBSTANCE
}

model TrainingRequirementSource {
  id                String                @id @default(cuid())
  requirementTypeId String
  subjectType       RequirementSourceType
  subjectId         String
  createdAt         DateTime              @default(now())

  requirementType TrainingRequirementType @relation(fields: [requirementTypeId], references: [id], onDelete: Restrict)

  @@unique([requirementTypeId, subjectType, subjectId])
  @@index([requirementTypeId])
  @@index([subjectType, subjectId])
}

// P7d §C (SLD_P7B_DEFERRALS_RESOLVED.md): data retention. Desk research found
// NO statutory retention period for instruction records in AT/DE (ASchG §14 /
// ArbSchG §12 require proof, not a period) — so retention is company policy
// with a conservative platform default and an honest "no statutory period"
// basis shown in the UI. Accident records (statutory) are P10, not here.
enum RetentionRecordType {
  PERSON
  TRAINING_RECORD
  TRAINING_SESSION
  PERSON_ASSIGNMENT
  // P8 §3.4 substance records (non-person data).
  SDS
  SUBSTANCE_USE
  // Reserved for P10 (no rules seeded yet): per-person exposure registers.
  SUBSTANCE_EXPOSURE_KM
  SUBSTANCE_EXPOSURE_R
}

enum RetentionBasis {
  STATUTORY
  NO_STATUTORY_PERIOD
  POLICY_DEFAULT
}

enum RetentionTrigger {
  END_OF_EMPLOYMENT
  RECORD_DATE
  SUPERSEDED
  // P8 §3.4: retention runs from when the record was last used.
  LAST_USE
}

// Versioned, single-active catalogue — the fail-closed pattern used by every
// other catalogue here (hand-added partial unique index on isActive).
model RetentionRuleCatalogVersion {
  version     String   @id
  label       String
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  rules RetentionRule[]
}

model RetentionRule {
  id                  String              @id @default(cuid())
  catalogVersion      String
  country             CountryCode
  recordType          RetentionRecordType
  basis               RetentionBasis
  // ISO-8601 duration (e.g. "P10Y"), or null when there is no period.
  minRetention        String?
  trigger             RetentionTrigger
  sourceUrl           String?
  consolidatedVersion String?
  verifiedAt          DateTime?
  verifiedBy          String?
  verificationMethod  String?
  notes               String?
  createdAt           DateTime            @default(now())

  catalog RetentionRuleCatalogVersion @relation(fields: [catalogVersion], references: [version], onDelete: Restrict)

  @@unique([catalogVersion, country, recordType])
  @@index([catalogVersion, country])
}

// Per-company policy. May be LONGER than a statutory minimum, never shorter
// (validated in the lib gate). Pre-filled with the platform defaults.
model CompanyRetentionSetting {
  id          String              @id @default(cuid())
  companyId   String
  recordType  RetentionRecordType
  retention   String // ISO-8601 duration
  trigger     RetentionTrigger
  setByUserId String?             @db.Uuid
  setAt       DateTime            @default(now())

  @@unique([companyId, recordType])
  @@index([companyId])
}

// P7d §C.4: the anonymisation job never acts on its own the first time — it
// writes a PROPOSED batch a company_admin reviews and approves. After the
// first approval a company may opt into auto-execute (off by default).
enum RetentionBatchStatus {
  PROPOSED
  APPROVED
  CANCELLED
}

model RetentionBatch {
  id               String               @id @default(cuid())
  companyId        String
  status           RetentionBatchStatus @default(PROPOSED)
  createdAt        DateTime             @default(now())
  approvedByUserId String?              @db.Uuid
  approvedAt       DateTime?

  items RetentionBatchItem[]

  @@index([companyId, status])
}

model RetentionBatchItem {
  id           String    @id @default(cuid())
  batchId      String
  // Plain personId (the batch outlives naming; the audit stores ids, not
  // names). maturedAt = when the retention matured, for traceability.
  personId     String
  maturedAt    DateTime
  anonymisedAt DateTime?

  batch RetentionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model CompanyRetentionConfig {
  id              String   @id @default(cuid())
  companyId       String   @unique
  autoExecute     Boolean  @default(false)
  updatedByUserId String?  @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt
}

// P8 §3.4: non-person substance-record deletion batches. Deliberately separate
// from RetentionBatch (person anonymisation) — the two kinds of review must
// never be co-approved, and no FK reaches into the people compartment. Approval
// HARD-DELETES the matured SDS / SubstanceUse rows (REACH Art. 36 period passed).
model SubstanceRetentionBatch {
  id               String               @id @default(cuid())
  companyId        String
  status           RetentionBatchStatus @default(PROPOSED)
  createdAt        DateTime             @default(now())
  approvedByUserId String?              @db.Uuid
  approvedAt       DateTime?

  items SubstanceRetentionItem[]

  @@index([companyId, status])
}

model SubstanceRetentionItem {
  id         String              @id @default(cuid())
  batchId    String
  // recordType is SDS or SUBSTANCE_USE (hand-added CHECK); recordId is its
  // plain id (the batch outlives the row, like RetentionBatchItem's personId).
  recordType RetentionRecordType
  recordId   String
  maturedAt  DateTime
  deletedAt  DateTime?

  batch SubstanceRetentionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

// P8 Gefahrstoffe (SLD_P8_GEFAHRSTOFFE_APPROVED.md). Person-free: substances
// describe the job. CLP enums are EU-wide (Regulation (EC) No 1272/2008).
enum PhysicalState {
  SOLID
  LIQUID
  GAS
  POWDER
  GRANULATE
  PASTE
  AEROSOL
  OTHER
}

enum SubstanceSignalWord {
  GEFAHR
  ACHTUNG
  NONE
}

enum CmrCategory {
  CAT_1A
  CAT_1B
  CAT_2
  NONE
}

enum GhsPictogram {
  GHS01
  GHS02
  GHS03
  GHS04
  GHS05
  GHS06
  GHS07
  GHS08
  GHS09
}

enum SubstanceStatementKind {
  H
  P
  EUH
}

enum SubstanceQuantityClass {
  XS
  S
  M
  L
  XL
}

enum ExposureRoute {
  INHALATION
  DERMAL
  ORAL
  EYE
}

model Substance {
  id                         String              @id @default(cuid())
  companyId                  String
  tradeName                  String
  manufacturer               String?
  casNumber                  String?
  ecNumber                   String?
  physicalState              PhysicalState
  signalWord                 SubstanceSignalWord @default(NONE)
  carcinogenicCategory       CmrCategory         @default(NONE)
  mutagenicCategory          CmrCategory         @default(NONE)
  reprotoxicCategory         CmrCategory         @default(NONE)
  substitutionCheckDone      Boolean             @default(false)
  substitutionCheckNote      String?
  substitutionCheckedAt      DateTime?
  excludedLowHazard          Boolean             @default(false)
  excludedLowHazardRationale String?
  environmentalAspectId      String?
  wasteStreamId              String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  environmentalAspect   EnvironmentalAspect?   @relation(fields: [environmentalAspectId], references: [id], onDelete: Restrict)
  wasteStream           WasteStream?           @relation(fields: [wasteStreamId], references: [id], onDelete: Restrict)
  pictograms            SubstancePictogram[]
  statements            SubstanceStatement[]
  safetyDataSheets      SafetyDataSheet[]
  uses                  SubstanceUse[]
  findingLinks          FindingSubstance[]
  operatingInstructions OperatingInstruction[]

  @@index([companyId])
}

model SubstancePictogram {
  id          String       @id @default(cuid())
  substanceId String
  pictogram   GhsPictogram

  substance Substance @relation(fields: [substanceId], references: [id], onDelete: Restrict)

  @@unique([substanceId, pictogram])
  @@index([substanceId])
}

model SubstanceStatement {
  id          String                 @id @default(cuid())
  substanceId String
  kind        SubstanceStatementKind
  code        String
  text        String?

  substance Substance @relation(fields: [substanceId], references: [id], onDelete: Restrict)

  @@index([substanceId])
}

model SafetyDataSheet {
  id           String    @id @default(cuid())
  substanceId  String
  version      String?
  revisionDate DateTime
  language     String
  supplier     String?
  documentId   String?
  supersededAt DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  substance Substance @relation(fields: [substanceId], references: [id], onDelete: Restrict)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([substanceId])
}

model SubstanceUse {
  id              String                 @id @default(cuid())
  substanceId     String
  siteId          String
  workstationId   String?
  processId       String?
  orgUnitId       String?
  purpose         String
  quantityClass   SubstanceQuantityClass
  storageLocation String?
  exposureRoutes  ExposureRoute[]
  activeFrom      DateTime
  activeTo        DateTime?
  createdAt       DateTime               @default(now())

  substance   Substance    @relation(fields: [substanceId], references: [id], onDelete: Restrict)
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workstation Workstation? @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  process     Process?     @relation(fields: [processId], references: [id], onDelete: Restrict)
  orgUnit     OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@index([substanceId])
  @@index([siteId])
}

// P6 §6 FindingSubstance, activated in P8: a CHEMICAL / DUST_PARTICULATE
// finding can reference the substances involved.
model FindingSubstance {
  id            String @id @default(cuid())
  riskFindingId String
  substanceId   String

  riskFinding RiskFinding @relation(fields: [riskFindingId], references: [id], onDelete: Restrict)
  substance   Substance   @relation(fields: [substanceId], references: [id], onDelete: Restrict)

  @@unique([riskFindingId, substanceId])
  @@index([riskFindingId])
  @@index([substanceId])
}

// P8 §3.2: a Betriebsanweisung (operating instruction) for a substance at a
// site. Draft → approved (a human must approve before it counts as valid).
// basedOnSdsRevisionDate snapshots the SDS it was built from, so a newer SDS
// revision flags it "Überprüfung erforderlich". Reuses RiskAssessmentStatus
// (DRAFT / IN_REVIEW / APPROVED; only DRAFT+APPROVED used here).
model OperatingInstruction {
  id                     String               @id @default(cuid())
  substanceId            String
  siteId                 String
  status                 RiskAssessmentStatus @default(DRAFT)
  approvedByUserId       String?              @db.Uuid
  approvedAt             DateTime?
  basedOnSdsRevisionDate DateTime?
  generatedDocumentId    String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  substance Substance @relation(fields: [substanceId], references: [id], onDelete: Restrict)
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([substanceId])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// P9 Begehungen & Audits (SLD_RESTRUCTURE_PLAN_platform-modules.md §7.3).
// Configurable inspections/audits/checklists; observations become Actions via
// the one action engine (§2.2). Person-free: inspections assess CONDITIONS,
// never a worker (§3.1); the team is PlatformUsers (staff accounts, plain uuid
// like Action.responsibleUserId, §3.13), and photos document conditions with a
// "do not photograph people" UI notice (§7.3). Legal reference per question is
// a loose code into the existing legal catalogue, left null in system seeds so
// no legal text is invented here (country-scoped legal content lives elsewhere).
// ---------------------------------------------------------------------------
enum InspectionDomain {
  OSH
  ENVIRONMENT
}

enum InspectionType {
  WALKTHROUGH
  AUDIT
  EQUIPMENT_INSPECTION
  COMPLIANCE_CHECKLIST
  ISO_INTERNAL_AUDIT
}

enum InspectionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum InspectionAnswerType {
  YES_NO_NA
  SCALE
  NUMBER
  TEXT
  CHOICE
  FILE
}

enum YesNoNa {
  YES
  NO
  NA
}

// A template is system (companyId null), company-wide (companyId set, siteId
// null) or site-specific (both set). Versioned by a plain int + isActive, so a
// company can revise a checklist without losing past inspections (which snapshot
// their questions onto InspectionAnswer rows at creation, §H1 pattern).
model InspectionTemplate {
  id          String           @id @default(cuid())
  companyId   String?
  siteId      String?
  domain      InspectionDomain @default(OSH)
  type        InspectionType
  title       String
  description String?
  version     Int              @default(1)
  isActive    Boolean          @default(true)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company  Company?                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site     Site?                       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  sections InspectionTemplateSection[]

  @@index([companyId])
  @@index([siteId])
}

model InspectionTemplateSection {
  id         String @id @default(cuid())
  templateId String
  title      String
  order      Int    @default(0)

  template  InspectionTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions InspectionTemplateQuestion[]

  @@index([templateId])
}

model InspectionTemplateQuestion {
  id                 String               @id @default(cuid())
  sectionId          String
  prompt             String
  answerType         InspectionAnswerType @default(YES_NO_NA)
  required           Boolean              @default(true)
  order              Int                  @default(0)
  legalReferenceCode String?
  unit               String?
  choiceOptions      String[]

  section InspectionTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// An inspection instance. Subject (workstation/org unit) is a plain id — like
// the team's platformUserId — so this never adds a back-relation into the
// assessment chain. Title/type/domain are snapshotted from the template.
model Inspection {
  id                   String           @id @default(cuid())
  siteId               String
  templateId           String?
  templateVersion      Int?
  title                String
  type                 InspectionType
  domain               InspectionDomain @default(OSH)
  status               InspectionStatus @default(PLANNED)
  subjectWorkstationId String?
  subjectOrgUnitId     String?
  plannedDate          DateTime?
  performedDate        DateTime?
  performedByUserId    String?          @db.Uuid
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  site         Site                    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  team         InspectionTeamMember[]
  answers      InspectionAnswer[]
  observations InspectionObservation[]

  @@index([siteId, status])
}

model InspectionTeamMember {
  id             String @id @default(cuid())
  inspectionId   String
  platformUserId String @db.Uuid

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, platformUserId])
  @@index([inspectionId])
}

// One row per template question, snapshotted at inspection creation so a later
// template edit never changes a past inspection. Exactly one value column is
// meaningful per answerType; "answered" = the relevant column is non-null (or
// YES_NO_NA set). A hand-added CHECK is not used here — the shape is enforced
// in the lib gate, same as the zone/manual-input read paths.
model InspectionAnswer {
  id                 String               @id @default(cuid())
  inspectionId       String
  questionId         String
  sectionTitle       String
  prompt             String
  answerType         InspectionAnswerType
  required           Boolean              @default(true)
  order              Int                  @default(0)
  legalReferenceCode String?
  unit               String?
  choiceOptions      String[]
  valueYesNoNa       YesNoNa?
  valueNumber        Float?
  valueText          String?
  valueChoice        String?
  documentId         String?
  answeredAt         DateTime?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// A deviation noted during the walk. Promotion to an Action is the one action
// engine (§2.2): Action.inspectionObservationId is the fourth source. Promotion
// to a RiskFinding needs a target assessment + hazard mapping and is deferred
// (recorded) — observations carry severity so that promotion can resolve a band.
model InspectionObservation {
  id           String    @id @default(cuid())
  inspectionId String
  answerId     String?
  description  String
  severity     RiskBand?
  createdAt    DateTime  @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  actions    Action[]

  @@index([inspectionId])
}
