// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Schema shape is governed by ERGO_COMPLIANCE_BY_DESIGN.md §3.1-§3.3 and §4.
// Non-negotiable: no field here may store or reference a specific worker's
// identity (employee_id, name, badge number, etc.). The primary entity chain
// is company -> site -> workstation -> task -> posture_sample -> body_region_score,
// with manual_input attached to a task and assessment_session grouping a
// dated set of tasks at a workstation (via assessment_session_task).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The tenant. Top of the hierarchy — every site (and transitively every
/// workstation) belongs to exactly one company.
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites         Site[]
  platformUsers PlatformUser[]
  hazards       Hazard[]
}

/// A physical location/department within a company (conversationally
/// "workplace"). Belongs to exactly one company.
model Site {
  id        String      @id @default(cuid())
  companyId String
  name      String
  address   String?
  // Which legal/jurisdiction frame applies to this site's data (limit
  // catalog, SGD generator, exposure evaluation) — deliberately NOT on
  // Company: a company can have sites in more than one country, and the
  // legal frame follows the physical site, not the tenant
  // (SLD_IMPLEMENTATION_PLAN_austria-first.md §4.3). Always explicit, never
  // defaulted or inferred (ERGO_COMPLIANCE_BY_DESIGN.md §3.15) — every
  // existing row was backfilled explicitly in the migration that added this
  // column, same discipline as AssessmentSession.mode.
  country   CountryCode
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Restrict: forces explicit offboarding of a company's sites rather than
  // an accidental cascade wipe of everything under it.
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workstations    Workstation[]
  siteAssignments SiteAssignment[]
  orgUnits        OrgUnit[]
  processes       Process[]
  riskAssessments RiskAssessment[]
  actions         Action[]
  floorPlans      FloorPlan[]

  @@index([companyId])
}

/// Jurisdiction a Site is physically located in — drives which legal limit
/// catalog, SGD template, and country-pack terminology apply
/// (ERGO_COMPLIANCE_BY_DESIGN.md §3.15,
/// SLD_IMPLEMENTATION_PLAN_austria-first.md §4). Not the same axis as
/// Locale (src/lib/i18n/locale.ts, en/de/ro, "what language") — country
/// answers "which law/limits/terminology," language answers "what words."
/// The two are deliberately kept on separate objects; do not merge them.
enum CountryCode {
  AT
  DE
  CH
  RO
}

/// Platform roles, from broadest to narrowest scope. See
/// ERGO_COMPLIANCE_BY_DESIGN.md "Tenant & role hierarchy" for the escalation
/// flow (site_admin -> company_admin -> l3_support -> super_admin).
enum PlatformRole {
  SUPER_ADMIN
  L3_SUPPORT
  COMPANY_ADMIN
  SITE_ADMIN
}

/// The only human-account table in the schema — unlike workstation, a name
/// and email here are expected: these are platform users (EHS managers, HR
/// staff, site coordinators, internal support/admin), not assessment
/// subjects. Never let a field from here find its way onto Workstation or
/// anything below it.
///
/// `id` is intentionally not a generated cuid: it is the same UUID as the
/// corresponding Supabase `auth.users.id` row (one auth identity, one
/// platform_user row). Provisioning only ever happens via an invite-only
/// admin flow — there is no public sign-up path that creates either row.
///
/// `companyId` is enforced (nullable for super_admin/l3_support, required
/// for company_admin/site_admin) by a CHECK constraint added in migration
/// SQL, since Prisma's schema language has no native way to express a
/// column constraint conditioned on another column's value. Likewise the FK
/// from `id` to `auth.users.id` is hand-added SQL, since Prisma doesn't
/// model the `auth` schema. Prisma's drift detection doesn't know about
/// either: review any future auto-generated migration touching this table
/// for an accidental `DROP CONSTRAINT` before applying it.
model PlatformUser {
  id        String       @id @db.Uuid
  role      PlatformRole
  companyId String?
  name      String
  email     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Restrict: a company with an active admin account can't be deleted out
  // from under them.
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  siteAssignments SiteAssignment[]
}

/// Scopes a site_admin to the specific site(s) they cover. Only meaningful
/// for the site_admin role — company_admin's scope is implicit (every site
/// where site.companyId matches their own companyId) and needs no join row.
model SiteAssignment {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  siteId    String
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

/// A physical work area/station being assessed. Primary entity — never linked
/// to a specific worker (§3.1, §4). Belongs to exactly one site; a site
/// belongs to exactly one company (tenant).
model Workstation {
  id          String   @id @default(cuid())
  siteId      String
  orgUnitId   String?
  name        String
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict, not Cascade: a site should be offboarded/archived explicitly,
  // never have its workstations (and their assessment history) silently
  // wiped out as a side effect of deleting the site (§3.6 audit trail).
  //
  // orgUnitId is additive-only grouping/presentation on top of an access
  // model that already works via siteId — see the OrgUnit model doc
  // comment below. Never make this required or derive site from the org
  // tree; siteId stays the sole authorization-relevant column here.
  site               Site                      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  orgUnit            OrgUnit?                  @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  tasks              Task[]
  assessmentSessions AssessmentSession[]
  riskAssessments    RiskAssessment[]
  planPositions      WorkstationPlanPosition[]

  @@index([siteId])
  @@index([orgUnitId])
}

/// A specific job/task performed at a workstation (e.g. "pallet loading",
/// "component inspection"). Describes the work, never the worker performing it.
/// Belongs to exactly one workstation; grouped into dated assessments via
/// AssessmentSessionTask rather than owned by any one session, since the
/// same task is expected to be re-assessed over time.
model Task {
  id            String   @id @default(cuid())
  workstationId String
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Restrict, matching every other relation in this chain: a task with
  // assessment history behind it can't be deleted out from under that
  // history (§3.6 audit trail).
  workstation        Workstation             @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  postureSamples     PostureSample[]
  manualInputs       ManualInput[]
  assessmentSessions AssessmentSessionTask[]
  processTasks       ProcessTask[]
  planPositions      TaskPlanPosition[]

  @@index([workstationId])
}

/// Dual-mode decision (§5, ERGO_COMPLIANCE_BY_DESIGN.md, resolved
/// 2026-07): SCHEDULED is the current, only-implemented regime —
/// operator-triggered discrete captures, workstation-audit framing.
/// CONTINUOUS is designed for structurally (mandate 3.11) but has no
/// implementation yet — createAssessmentSession()
/// (src/lib/assessment-session/create-assessment-session.ts) throws if
/// asked to create one. Do not remove that guard just because this enum
/// value exists; the schema being ready and the feature being ready are
/// deliberately different milestones (feature flag + a documented
/// worker-rep consent artifact per deployment are the actual gate).
enum AssessmentMode {
  SCHEDULED
  CONTINUOUS
}

/// A dated assessment event at a workstation, grouping the set of tasks
/// that were assessed during it. A task can appear in more than one
/// session over time (it's re-assessed on a later date), so the task set
/// is a join (AssessmentSessionTask), not a direct FK on Task.
///
/// `mode` is recorded per session, never inferred or left to a default at
/// read time — see AssessmentMode doc comment and mandate 3.11. Existing
/// rows predating this field were backfilled to SCHEDULED explicitly in
/// the migration that added it, not left to ride on the column default.
///
/// `pilotContext` is free-text, internal-only metadata (§3.6 audit trail)
/// for annotating why a session exists — e.g. a technical pilot at a
/// partner site vs. an internal validation study vs. a real customer
/// engagement — so pilot/test data can be cleanly separated from real
/// customer data in later analysis. Nullable: most sessions won't have it
/// set. Deliberately not surfaced in the customer-facing dashboard
/// (src/app/(app)/**) — super_admin-only, via the internal /admin tool.
model AssessmentSession {
  id            String         @id @default(cuid())
  workstationId String
  mode          AssessmentMode @default(SCHEDULED)
  pilotContext  String?
  startedAt     DateTime
  endedAt       DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workstation Workstation             @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  tasks       AssessmentSessionTask[]
  actions     Action[]

  @@index([workstationId])
}

/// Join table: which tasks were covered by a given assessment session.
model AssessmentSessionTask {
  id                  String   @id @default(cuid())
  assessmentSessionId String
  taskId              String
  createdAt           DateTime @default(now())

  assessmentSession AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Restrict)
  task              Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([assessmentSessionId, taskId])
  @@index([taskId])
}

/// The viewpoint a PostureSample was captured from. Matters for which joint
/// angles the sample can support: sagittal (side-on) is needed for trunk
/// flexion, frontal (front-on) for lateral bending/deviation; oblique views
/// are recorded as such rather than misclassified as one of the two.
enum CameraAngle {
  FRONTAL
  SAGITTAL
  OBLIQUE
}

/// How a PostureSample's angles were obtained (ERGO_COMPLIANCE_BY_DESIGN.md
/// §3.16, SLD_IMPLEMENTATION_PLAN_austria-first.md §5) — recorded on every
/// sample, never inferred, so a generated artifact can always state
/// whether a value is camera-measured or manually entered rather than
/// presenting the two as interchangeable. IMPORTED_MODEL is reserved, no
/// implementation anywhere in the app — createPostureSample()
/// (src/lib/capture/create-posture-sample.ts) throws if asked for it, same
/// discipline as createAssessmentSession() throwing on
/// AssessmentMode.CONTINUOUS.
enum PostureSampleSource {
  CAMERA_MEDIAPIPE
  MANUAL_ENTRY
  IMPORTED_MODEL
}

/// Whether a PostureSample's keypoints have been reviewed/adjusted by a
/// human yet. PENDING_REVIEW is the state every new sample is created in —
/// the scoring pipeline (POST /api/posture-samples) always scores from the
/// original `keypoints` and sets this on creation. VALIDATED means a
/// reviewer has confirmed (optionally adjusting) the landmark positions,
/// re-scored from `validatedKeypoints` by validatePostureSample
/// ((app)/tasks/[taskId]/actions.ts). A VALIDATED sample isn't permanently
/// frozen: reopenPostureSampleForEdit (same file) flips it back to
/// PENDING_REVIEW so it can be re-validated — every such transition, in
/// either direction, is recorded in PostureSampleValidationEvent (below),
/// never silent. See PostureSample.validatedKeypoints for why the original
/// `keypoints` column is never overwritten.
enum ValidationStatus {
  PENDING_REVIEW
  VALIDATED
}

/// A single derived-pose snapshot captured while a task is performed.
/// `source` records how it was obtained (ERGO_COMPLIANCE_BY_DESIGN.md
/// §3.16) — never inferred, always explicit, backfilled to
/// CAMERA_MEDIAPIPE for every pre-existing row.
///
/// `keypoints` holds only joint positions/angles produced by client-side
/// MediaPipe processing — never a raw video frame, and never data
/// reusable to re-identify a person (§3.2, §4). This column is NEVER
/// overwritten once written: it stays the immutable audit-trail record of
/// exactly what MediaPipe produced, even after a human review adjusts it.
/// Nullable, and only actually null for `source = MANUAL_ENTRY` — see
/// `manualAngles` below and the hand-added
/// `PostureSample_source_shape_check` CHECK (migration SQL) that enforces
/// keypoints/manualAngles presence by source, same pattern as
/// `ManualInput_value_shape_check`.
///
/// `manualAngles` is the manual-entry counterpart to `keypoints`: the raw
/// angle an assessor entered per computed BodyRegion (goniometer/tape
/// measure, flexion-from-neutral convention — see CLAUDE.md "Scoring
/// methodology"), stored regardless of whether it matched a ScoringRule.
/// It exists specifically so a region that didn't match any rule can still
/// be reported honestly at read time (`no-matching-rule`, with the actual
/// entered degrees) without recomputing — `BodyRegionScore` only ever
/// holds rows for regions that DID match (see that model's own comment),
/// so an unmatched manual angle has nowhere else to live. Never set
/// alongside `keypoints`.
///
/// `validatedKeypoints` holds a reviewer's adjusted landmark positions,
/// separate from `keypoints` above. `validationStatus = VALIDATED`
/// requires `validatedKeypoints`/`validatedAt`/`validatedByUserId` to all
/// be set together — enforced by a HAND-ADDED CHECK constraint in
/// migration SQL (`PostureSample_validation_completeness_check`, same
/// technique as ManualInput_value_shape_check), added NOT VALID against
/// pre-existing rows (see that migration's comments for why). While
/// PENDING_REVIEW, a reviewer may save `validatedKeypoints` alone as a
/// mid-adjustment draft — the CHECK only fires once `validationStatus`
/// flips to VALIDATED. `validatedByUserId` references PlatformUser only, a
/// plain @db.Uuid column not a DB-level FK — same pattern as
/// RiskAssessment.assessorUserId. This whole validation workflow is about
/// reviewing/adjusting *keypoints* — it doesn't apply to a MANUAL_ENTRY
/// sample (no keypoints exist to adjust), so those samples stay
/// PENDING_REVIEW permanently; `validatePostureSample`/
/// `reopenPostureSampleForEdit` ((app)/tasks/[taskId]/actions.ts) both
/// reject any sample whose `source` isn't CAMERA_MEDIAPIPE.
///
/// Samples that predate the `validationStatus` column were backfilled to
/// VALIDATED explicitly in the migration that added it (they were already
/// human-reviewed through the old capture confirmation flow) — treating
/// them as PENDING_REVIEW would retroactively downgrade data already
/// acted on. Those specific rows have no real validatedKeypoints/
/// validatedAt/validatedByUserId (nothing to backfill them with), which is
/// exactly what the CHECK's NOT VALID addition permanently exempts.
model PostureSample {
  id                  String              @id @default(cuid())
  taskId              String
  capturedAt          DateTime
  cameraAngle         CameraAngle
  source              PostureSampleSource
  frameIndex          Int?
  keypoints           Json?
  manualAngles        Json?
  /// How long THIS specific captured/entered posture was held, in seconds
  /// (SLD_IMPLEMENTATION_PLAN_austria-first.md §6) — feeds the hold-time
  /// sub-score (see HoldTimeRule below), never the posture-band scoring
  /// itself. Optional: most samples don't record it. NOT the same quantity
  /// as `ManualInput.DURATION_SECONDS`, which is a task-level "how long
  /// does one cycle of this task take" figure, unrelated to any single
  /// posture — see that enum value's own comment. Conflating the two was
  /// flagged as a real risk when this column was added; don't.
  holdDurationSeconds Int?
  validatedKeypoints  Json?
  validationStatus    ValidationStatus
  validatedAt         DateTime?
  validatedByUserId   String?             @db.Uuid
  createdAt           DateTime            @default(now())

  task             Task                           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  bodyRegionScores BodyRegionScore[]
  validationEvents PostureSampleValidationEvent[]

  @@index([taskId])
}

/// Append-only validationStatus transition history (§3.6) — same shape and
/// rationale as ActionStatusEvent: PENDING_REVIEW -> VALIDATED (a fresh
/// validatePostureSample call) and VALIDATED -> PENDING_REVIEW (a
/// reopenPostureSampleForEdit call) are both recorded here, with who did it
/// and an optional note, so "this measurement was edited after being
/// finalized" is always a real, attributable, queryable fact — never a
/// silent overwrite. byUserId is a plain @db.Uuid column, not a DB-level FK
/// to PlatformUser — same pattern as PostureSample.validatedByUserId and
/// ActionStatusEvent.byUserId (§3.13).
model PostureSampleValidationEvent {
  id              String            @id @default(cuid())
  postureSampleId String
  fromStatus      ValidationStatus?
  toStatus        ValidationStatus
  byUserId        String            @db.Uuid
  note            String?
  createdAt       DateTime          @default(now())

  postureSample PostureSample @relation(fields: [postureSampleId], references: [id], onDelete: Restrict)

  @@index([postureSampleId])
}

/// One body-region risk score derived from a posture sample — one row per
/// body region per sample. `scoringRuleVersion` tags which ScoringRule
/// vintage (methodologyVersion) produced the score; the lookup itself
/// (matching an angle to a ScoringRule row) is scoring-engine logic and is
/// intentionally not modeled/implemented here.
///
/// `riskBand` is nullable and, deliberately, only ever populated for
/// MANUAL_ENTRY-sourced rows (createPostureSample,
/// src/lib/capture/create-posture-sample.ts, persists it at write time
/// from the same ScoringRule match that produced `score`). The camera
/// path leaves it null: buildRegionResults' CAMERA_MEDIAPIPE branch always
/// recomputes region results live from `PostureSample.keypoints`, exactly
/// as before, so it never needs a persisted band. A manual sample has no
/// keypoints to recompute from, so its read side (buildRegionResults'
/// MANUAL_ENTRY branch) reads this column directly instead — deriving a
/// band back from `score` alone would be unreliable, since NECK's
/// non-monotonic rule set gives its two HIGH-band rows two *different*
/// riskScore values (see CLAUDE.md "Scoring methodology").
model BodyRegionScore {
  id                 String     @id @default(cuid())
  postureSampleId    String
  bodyRegion         BodyRegion
  score              Float
  riskBand           RiskBand?
  scoringRuleVersion String?
  createdAt          DateTime   @default(now())

  postureSample PostureSample @relation(fields: [postureSampleId], references: [id], onDelete: Restrict)

  @@unique([postureSampleId, bodyRegion])
  @@index([postureSampleId])
}

/// Manually entered inputs an assessor supplies for a task — load weight,
/// push/pull force, tool used — that computer vision cannot derive from
/// video alone. One row per entry, so a task can carry any number of these
/// (e.g. both a push and a pull force, or a tool plus a weight).
///
/// `value`/`unit` (numeric entries) and `textValue` (TOOL_USED) are
/// mutually exclusive depending on `inputType`, enforced by a CHECK
/// constraint added in migration SQL — see the note on PlatformUser above
/// for why this lives outside schema.prisma, and the same drift-detection
/// caveat applies here.
model ManualInput {
  id        String          @id @default(cuid())
  taskId    String
  inputType ManualInputType
  value     Float?
  unit      String?
  textValue String?
  notes     String?
  createdAt DateTime        @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

enum BodyRegion {
  NECK
  TRUNK
  SHOULDER_LEFT
  SHOULDER_RIGHT
  UPPER_ARM_LEFT
  UPPER_ARM_RIGHT
  ELBOW_LEFT
  ELBOW_RIGHT
  FOREARM_LEFT
  FOREARM_RIGHT
  WRIST_LEFT
  WRIST_RIGHT
  HIP
  KNEE_LEFT
  KNEE_RIGHT
  ANKLE_LEFT
  ANKLE_RIGHT
}

/// Qualitative risk tier a ScoringRule row falls into. ELEVATED sits between
/// MODERATE and HIGH — used where a methodology needs a fourth tier (e.g.
/// shoulder flexion) rather than collapsing straight from MODERATE to HIGH.
enum RiskBand {
  LOW
  MODERATE
  ELEVATED
  HIGH
}

/// Tracks which ScoringRule vintage is "current" for new lookups, as real
/// data rather than a code constant — so activating a new methodology
/// version is a data change (flip isActive), not a deploy, and which
/// version was active at any point in time stays reconstructable from
/// `activatedAt`.
///
/// At most one row may have isActive = true. Prisma's schema language can't
/// express a partial/filtered unique index, so that constraint is hand-added
/// in migration SQL (`MethodologyVersion_isActive_unique_when_true`) — same
/// caveat as the other hand-added constructs in this schema: Prisma's drift
/// detection doesn't know about it, review any future auto-generated
/// migration touching this table before applying it. A lookup that finds
/// zero active rows must fail closed (error), never silently fall back to
/// some other version.
model MethodologyVersion {
  version     String   @id
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  scoringRules        ScoringRule[]
  holdTimeRules       HoldTimeRule[]
  manualHandlingRules ManualHandlingRule[]
  repetitionRules     RepetitionRule[]
}

/// Versioned scoring thresholds (§3.8): the "rule content" that
/// BodyRegionScore.scoringRuleVersion tags but doesn't itself hold. Rows are
/// data, not code — a new methodologyVersion is a new set of rows, never an
/// edit to existing ones, so a past score's rule version stays reproducible.
///
/// Angles are flexion-from-neutral degrees (0° = upright/anatomical
/// position), independent of which side of a bilateral joint they're for.
/// [angleMin, angleMax) bounds a band; either end may be null for an
/// open-ended band (e.g. HIGH trunk flexion has no upper bound). A body
/// region can have more than one row in the same band (see ELBOW_LEFT/RIGHT
/// HIGH: risk at both very extended and very flexed ends, with LOW as the
/// single band in between; NECK is the same shape around 0° — MODERATE and
/// HIGH each appear once on the forward-flexion side and once on the
/// backward-extension side, the latter pair with different riskScores) —
/// so there is deliberately no uniqueness constraint on
/// (methodologyVersion, bodyRegion, riskBand).
model ScoringRule {
  id                 String     @id @default(cuid())
  methodologyVersion String
  bodyRegion         BodyRegion
  riskBand           RiskBand
  riskScore          Int
  angleMin           Float?
  angleMax           Float?
  createdAt          DateTime   @default(now())

  // Restrict: a methodology version with rules still referencing it can't
  // be deleted out from under them.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@index([methodologyVersion, bodyRegion])
}

/// Versioned hold-time ceilings (SLD_IMPLEMENTATION_PLAN_austria-first.md
/// §6): "how long is it acceptable to sustain a posture that already
/// scores this severely." Independently designed by SLD, inspired by ISO
/// 11226's general "duration allowance shrinks as posture severity rises"
/// principle — not a reproduction of that standard's own figures, same
/// arm's-length relationship the rest of this scoring engine has to ISO
/// 11228/EN 1005 (ERGO_COMPLIANCE_BY_DESIGN.md §3.7). Keyed by the
/// *posture's own* riskBand (its worst scored region), not by raw angle —
/// a deliberately coarser grain than ScoringRule's angle ranges, since
/// this is a severity-tier ceiling, not a region-specific curve.
/// `maxHoldSeconds = null` means no ceiling at that severity (a LOW-band
/// posture is fine to sustain). One row per (methodologyVersion,
/// postureRiskBand) — see `HoldTimeRule_methodologyVersion_postureRiskBand_key`.
model HoldTimeRule {
  id                 String   @id @default(cuid())
  methodologyVersion String
  postureRiskBand    RiskBand
  maxHoldSeconds     Int?
  createdAt          DateTime @default(now())

  // Restrict: same reasoning as ScoringRule.methodology.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@unique([methodologyVersion, postureRiskBand])
}

/// Versioned manual-handling load-weight bands (SLD_IMPLEMENTATION_PLAN_
/// austria-first.md §7 B8): a parallel sub-score against `ManualInput`'s
/// `LOAD_WEIGHT_KG` value, closing the "§64 ASchG requires manual load
/// handling to be evaluated but Austria has no Lastenhandhabungsverordnung
/// (no mandated method)" gap the plan's §2(c) documents. Independently
/// designed by SLD, inspired by ISO 11228-1's general "the further above
/// the ~25 kg ideal-conditions reference mass, the higher the risk"
/// principle — deliberately NOT a reproduction of ISO 11228-1's own
/// Recommended Mass Limit tables or the Revised NIOSH Lifting Equation (a
/// multiplier chain over posture × load × frequency is structurally an
/// EAWS clone, forbidden by ERGO_COMPLIANCE_BY_DESIGN.md §3.7) — same
/// arm's-length relationship HoldTimeRule already has to ISO 11226.
///
/// Keyed by raw kg, same [min, max) inclusive-min/exclusive-max shape as
/// ScoringRule's angle ranges (matchManualHandlingRule mirrors
/// matchScoringRule directly) — a fresh, independent scoring axis, not
/// derived from or blended with the posture band the way HoldTimeRule is
/// (§6/§11: "parallel sub-scores, not a blended composite").
///
/// Folded into the existing `v2-2026-08` MethodologyVersion rather than a
/// new version, per the plan's explicit instruction ("folded into the
/// same v2 methodology version") — versioning per factor would turn
/// MethodologyVersion from an audit anchor into a matrix nobody can
/// reason about.
model ManualHandlingRule {
  id                 String   @id @default(cuid())
  methodologyVersion String
  riskBand           RiskBand
  riskScore          Int
  minKg              Float?
  maxKg              Float?
  createdAt          DateTime @default(now())

  // Restrict: same reasoning as ScoringRule.methodology.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@index([methodologyVersion])
}

/// Versioned repetition-count bands (SLD_NEXT_STEPS_B8b-B8f.md B8d): a
/// parallel sub-score against `ManualInput`'s `REPETITION_COUNT` value,
/// closing the "a high-rep low-load task shows three green sub-scores"
/// gap — posture, hold-time, and manual-handling were all scored, but raw
/// repetition count was captured and read by nothing. Independently
/// designed by SLD, inspired by ISO 11228-3's general "the more frequently
/// a movement repeats, the higher the risk" principle — deliberately NOT
/// a reproduction of ISO 11228-3's own frequency (repetitions/minute)
/// tables or EN 1005-5's OCRA-derived multiplier method (a full frequency
/// calculation needs cycle time and recovery time this app doesn't
/// collect in v1 — see the plan's own "no frequency calculation
/// introduced" scope note); this scores the raw REPETITION_COUNT value
/// (reps per task cycle) directly, same coarser-than-the-standard
/// relationship HoldTimeRule already has to ISO 11226.
///
/// Keyed by raw rep count, same [min, max) inclusive-min/exclusive-max
/// shape as ManualHandlingRule's kg ranges (matchRepetitionRule mirrors
/// matchManualHandlingRule directly) — a fresh, independent scoring axis,
/// never blended with posture/hold-time/manual-handling (§6/§11:
/// "parallel sub-scores, not a blended composite").
///
/// Folded into the existing `v2-2026-08` MethodologyVersion rather than a
/// new version, same "folded into the same v2 methodology version"
/// instruction ManualHandlingRule followed — a brand-new capability with
/// no historical row to preserve parity against.
model RepetitionRule {
  id                 String   @id @default(cuid())
  methodologyVersion String
  riskBand           RiskBand
  riskScore          Int
  minReps            Float?
  maxReps            Float?
  createdAt          DateTime @default(now())

  // Restrict: same reasoning as ManualHandlingRule.methodology.
  methodology MethodologyVersion @relation(fields: [methodologyVersion], references: [version], onDelete: Restrict)

  @@index([methodologyVersion])
}

enum ManualInputType {
  LOAD_WEIGHT_KG
  PUSH_FORCE_N
  PULL_FORCE_N
  TOOL_USED
  REPETITION_COUNT
  /// Task-cycle duration — "how long does one run of this task take,"
  /// unrelated to any single posture. NOT the same quantity as
  /// `PostureSample.holdDurationSeconds` ("how long was THIS captured
  /// posture held"); the two look similar but answer different questions
  /// and must not be conflated (SLD_IMPLEMENTATION_PLAN_austria-first.md
  /// §6 flagged this explicitly when holdDurationSeconds was added).
  DURATION_SECONDS
}

// ---------------------------------------------------------------------------
// Process / risk / action register (SLD_IMPLEMENTATION_PLAN_demo-loop.md M2).
// Sits alongside the assessment chain above, not inside it: OrgUnit and
// Process are organisational/grouping concepts layered on the existing
// Site/Workstation/Task authorization model, never load-bearing for it.
// RiskAssessment/RiskFinding/Action describe the job, never a worker — same
// §1/§3.1 test as everything above. See ERGO_COMPLIANCE_BY_DESIGN.md
// mandates 3.12-3.14.
// ---------------------------------------------------------------------------

enum OrgUnitType {
  PLANT
  DEPARTMENT
  AREA
  LINE
}

/// Organisational structure within a site. Describes the organisation of
/// work, never a person (§1, §3.1). `siteId` is denormalised onto every
/// node deliberately: authorization must never require walking this tree —
/// `canAccessSite`/`require*Access` keep working unchanged regardless of
/// how deep or shallow a given org tree is.
model OrgUnit {
  id        String      @id @default(cuid())
  siteId    String
  parentId  String?
  type      OrgUnitType
  name      String
  code      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  parent       OrgUnit?      @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     OrgUnit[]     @relation("OrgUnitTree")
  workstations Workstation[]
  processes    Process[]

  @@index([siteId])
  @@index([parentId])
}

enum ProcessStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// A work process: an ordered set of tasks, possibly spanning workstations
/// within one site. Describes work, never a worker (§1).
model Process {
  id          String        @id @default(cuid())
  siteId      String
  orgUnitId   String?
  name        String
  code        String?
  description String?
  status      ProcessStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  site            Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  orgUnit         OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  tasks           ProcessTask[]
  riskAssessments RiskAssessment[]

  @@index([siteId])
}

/// Join: which tasks make up a process, in what order. A task may belong to
/// more than one process — same reasoning as AssessmentSessionTask.
///
/// No separate ProcessStep entity: Task already means "a specific job
/// performed at a workstation"; a process is a sequence of those. A
/// described step with no Task is a signal to create the task, not to
/// introduce a parallel model that drifts from it.
model ProcessTask {
  id        String   @id @default(cuid())
  processId String
  taskId    String
  sequence  Int
  createdAt DateTime @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([processId, taskId])
  @@index([taskId])
}

enum HazardCategory {
  PHYSICAL_MECHANICAL
  NOISE
  VIBRATION
  LIGHTING
  CLIMATE_THERMAL
  CHEMICAL
  DUST_PARTICULATE
  BIOLOGICAL
  ERGONOMIC_MSD
  PSYCHOSOCIAL
  ELECTRICAL
  FIRE_EXPLOSION
  RADIATION
}

/// Hazard catalog. companyId == null = system catalog (seeded, shared,
/// super_admin-only to write). companyId set = a company's own additions.
model Hazard {
  id          String         @id @default(cuid())
  companyId   String?
  category    HazardCategory
  code        String
  name        String
  description String?
  isSystem    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company  Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  findings RiskFinding[]

  @@index([companyId, category])
}

/// Which risk matrix is current is data, not a code constant — same design
/// and same fail-closed contract as MethodologyVersion (ERGO_COMPLIANCE_BY_
/// DESIGN.md §3.8, §3.14). At most one isActive = true, enforced by a
/// HAND-ADDED partial unique index in migration SQL (Prisma has no
/// filtered/partial index support) — see
/// MethodologyVersion_isActive_unique_when_true for the pattern this
/// copies. A lookup that finds zero active rows must fail closed, never
/// silently fall back to another version.
model RiskMatrixVersion {
  version     String   @id
  label       String
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  cells           RiskMatrixCell[]
  riskAssessments RiskAssessment[]
}

model RiskMatrixCell {
  id            String   @id @default(cuid())
  matrixVersion String
  probability   Int
  severity      Int
  riskScore     Int
  riskBand      RiskBand
  createdAt     DateTime @default(now())

  matrix RiskMatrixVersion @relation(fields: [matrixVersion], references: [version], onDelete: Restrict)

  @@unique([matrixVersion, probability, severity])
  @@index([matrixVersion])
}

enum RiskAssessmentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

/// A dated risk assessment of either a workstation or a process — exactly
/// one of the two, enforced by a HAND-ADDED CHECK constraint in migration
/// SQL (same technique as ManualInput_value_shape_check).
///
/// DRAFT -> IN_REVIEW -> APPROVED is ERGO_COMPLIANCE_BY_DESIGN.md §3.4
/// (mandatory human review) expressed as data. Never add an auto-approve
/// path.
///
/// pilotContext mirrors AssessmentSession.pilotContext — internal-only
/// audit metadata (§3.6) marking demo/pilot rows so they stay separable
/// from real customer data.
model RiskAssessment {
  id               String               @id @default(cuid())
  siteId           String
  workstationId    String?
  processId        String?
  matrixVersion    String
  status           RiskAssessmentStatus @default(DRAFT)
  assessorUserId   String               @db.Uuid
  approvedByUserId String?              @db.Uuid
  assessedAt       DateTime
  approvedAt       DateTime?
  pilotContext     String?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  site            Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workstation     Workstation?      @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  process         Process?          @relation(fields: [processId], references: [id], onDelete: Restrict)
  matrix          RiskMatrixVersion @relation(fields: [matrixVersion], references: [version], onDelete: Restrict)
  findings        RiskFinding[]
  verifiedActions Action[]          @relation("ActionVerificationAssessment")

  @@index([siteId])
  @@index([workstationId])
}

model RiskFinding {
  id                  String    @id @default(cuid())
  riskAssessmentId    String
  hazardId            String
  probability         Int
  severity            Int
  riskScore           Int
  riskBand            RiskBand
  existingControls    String?
  notes               String?
  residualProbability Int?
  residualSeverity    Int?
  residualRiskScore   Int?
  residualRiskBand    RiskBand?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  riskAssessment     RiskAssessment             @relation(fields: [riskAssessmentId], references: [id], onDelete: Restrict)
  hazard             Hazard                     @relation(fields: [hazardId], references: [id], onDelete: Restrict)
  measurements       ExposureMeasurement[]
  actions            Action[]
  psychosocialDetail PsychosocialFindingDetail?

  @@index([riskAssessmentId])
}

/// Instrument or survey measurement supporting a finding, with the legal
/// limit(s) it is compared against recorded alongside it.
///
/// Deliberately NOT merged with ManualInput despite the similar shape:
/// ManualInput is task-level input feeding the CV scoring path, this is
/// environmental data supporting a risk finding. Same shape, different
/// lifecycle and consumer — do not "DRY" them together.
///
/// Two-tier (SLD_IMPLEMENTATION_PLAN_austria-first.md §4.4): Austrian
/// noise/vibration law sets both a lower "Auslösewert" (action value —
/// crossing it obliges the employer to plan measures) and a higher
/// "Expositionsgrenzwert" (exposure limit value — must never be
/// exceeded). `limitValue`/`limitReference` (pre-existing) are the
/// exposure-limit tier; `actionValue`/`actionValueReference` are the new
/// action-value tier. Both are free-editable fields, not a hard copy of
/// `exposureLimit`'s row — a human can still override them — but
/// `exposureLimitId`, when set, records *which* catalog row (and
/// therefore which country and which `ExposureLimitCatalogVersion`)
/// originally informed the prefill, the same "never recomputed against
/// whatever is active now" reasoning `RiskAssessment.matrixVersion`
/// already follows. Null when a measurement was entered fully manually
/// (no matching catalog row for this market/parameter yet, e.g. CHEMICAL
/// or a non-AT site) — the pre-existing free-text fallback, unchanged.
model ExposureMeasurement {
  id                   String   @id @default(cuid())
  riskFindingId        String
  value                Float
  unit                 String
  actionValue          Float?
  actionValueReference String?
  limitValue           Float?
  limitReference       String?
  exposureLimitId      String?
  instrument           String?
  method               String?
  measuredAt           DateTime
  notes                String?
  createdAt            DateTime @default(now())

  riskFinding   RiskFinding    @relation(fields: [riskFindingId], references: [id], onDelete: Restrict)
  // Restrict: a catalog row a real measurement points to for provenance
  // can't be deleted out from under it — matches every other FK in this
  // schema's "versioned data is never removed" discipline.
  exposureLimit ExposureLimit? @relation(fields: [exposureLimitId], references: [id], onDelete: Restrict)

  @@index([riskFindingId])
  @@index([exposureLimitId])
}

/// Tracks which ExposureLimit catalog vintage is "current," as real data
/// rather than a code constant — the exact same fail-closed,
/// single-active-version contract as MethodologyVersion/RiskMatrixVersion
/// (ERGO_COMPLIANCE_BY_DESIGN.md §3.14/§3.15). At most one row may have
/// isActive = true, enforced by a HAND-ADDED partial unique index in
/// migration SQL (`ExposureLimitCatalogVersion_isActive_unique_when_true`,
/// mirroring `MethodologyVersion_isActive_unique_when_true` exactly) since
/// Prisma's schema language can't express one. A lookup that finds zero
/// active rows must fail closed (throw), never silently fall back to
/// another version or another country's catalog.
model ExposureLimitCatalogVersion {
  version     String   @id
  label       String
  isActive    Boolean  @default(false)
  activatedAt DateTime @default(now())

  limits ExposureLimit[]
}

/// One legal exposure limit for one parameter in one country, under one
/// catalog version (SLD_IMPLEMENTATION_PLAN_austria-first.md §4.5).
/// `actionValue`/`limitValue` are BOTH nullable, independently — a row
/// with both null and only `legalReference` set is a legitimate,
/// deliberately-modeled state meaning "the law requires this to be
/// evaluated but sets no single number" (e.g. ERGONOMIC_MSD, or CHEMICAL
/// where MAK/TRK values are substance-specific, not one figure). The UI
/// must render that as an obligation, not as a blank row.
///
/// `country` + `hazardCategory` + `parameterKey` is the lookup key
/// (`lookupExposureLimits`, src/lib/risk/exposure-limit-lookup.ts) —
/// never resolved with a fallback to a different country's row for the
/// same parameter (ERGO_COMPLIANCE_BY_DESIGN.md §3.15/§4 — showing a
/// German or generic number to an Austrian customer is a defect, not a
/// rounding error).
model ExposureLimit {
  id                String         @id @default(cuid())
  catalogVersion    String
  country           CountryCode
  hazardCategory    HazardCategory
  parameterKey      String
  parameterLabel    String
  unit              String
  actionValue       Float?
  limitValue        Float?
  legalReference    String
  legalReferenceUrl String?
  notes             String?
  createdAt         DateTime       @default(now())

  catalog      ExposureLimitCatalogVersion @relation(fields: [catalogVersion], references: [version], onDelete: Restrict)
  measurements ExposureMeasurement[]

  @@unique([catalogVersion, country, parameterKey])
  @@index([catalogVersion, country, hazardCategory])
}

/// The four dimensions Austrian guidance uses for evaluating
/// arbeitsbedingte psychische Belastungen (aligned to ÖNORM EN ISO
/// 10075-1/-3), SLD_IMPLEMENTATION_PLAN_austria-first.md §7 B7. A closed,
/// structural set the SGD reports on systematically — deliberately a real
/// enum, not four Hazard catalog rows a company_admin could rename or
/// delete (see PsychosocialFindingDetail below).
enum PsychosocialDimension {
  /// Arbeitsaufgabe und Tätigkeit
  TASK_AND_ACTIVITY
  /// Arbeitsorganisation und Arbeitsabläufe
  WORK_ORGANIZATION
  /// Arbeitsumgebung
  WORK_ENVIRONMENT
  /// Sozial- und Organisationsklima
  SOCIAL_CLIMATE
}

/// How a psychosocial finding's band was derived — recorded because the
/// Arbeitsinspektion asks, and because it gates the group-size CHECK below
/// (§7 B7: questionnaire instruments are unsuitable below 15 employees;
/// smaller groups use one of the other three methods instead).
enum PsychosocialMethod {
  QUESTIONNAIRE
  GROUP_DISCUSSION
  OBSERVATION
  INTERVIEW
}

/// Structured detail for a PSYCHOSOCIAL-category RiskFinding
/// (SLD_IMPLEMENTATION_PLAN_austria-first.md §7 B7) — "structured
/// findings, not a survey platform." One row per RiskFinding (1:1, see
/// the unique riskFindingId), same "related table rather than nullable
/// columns bolted onto RiskFinding" shape ExposureMeasurement already
/// uses for its own hazard-category-specific detail.
///
/// Deliberately absent from this model, permanently, per
/// ERGO_COMPLIANCE_BY_DESIGN.md §3.12/§4 and the locked decision recorded
/// there: any per-respondent field, any free-text verbatim response
/// field, any table keyed by an individual. `groupSize` is an aggregate
/// headcount the finding covers, never a link to who was in it.
/// `externalProcedureName` records *that* a named external Verfahren
/// (e.g. COPSOQ, AVEM) was used, never its raw responses — the
/// finding's own riskBand/notes (on RiskFinding) are what it concluded.
///
/// The group-size floor is real but conditional, not a blanket "always
/// ≥15": Austrian guidance (WKO/Arbeitsinspektion) says QUESTIONNAIRE
/// instruments specifically are unsuitable below 15 employees because
/// anonymity can't be preserved at that scale, and directs smaller
/// operations toward GROUP_DISCUSSION/OBSERVATION/INTERVIEW instead — so
/// the hand-added CHECK
/// (`PsychosocialFindingDetail_group_size_check`) only enforces the
/// floor when method = QUESTIONNAIRE.
model PsychosocialFindingDetail {
  id                    String                @id @default(cuid())
  riskFindingId         String                @unique
  dimension             PsychosocialDimension
  method                PsychosocialMethod
  groupSize             Int
  externalProcedureName String?
  createdAt             DateTime              @default(now())

  // Restrict: a psychosocial finding's structured detail can't be
  // deleted out from under the finding it describes — same discipline
  // as every other FK in this schema.
  riskFinding RiskFinding @relation(fields: [riskFindingId], references: [id], onDelete: Restrict)

  @@index([riskFindingId])
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
  CANCELLED
}

enum HierarchyOfControl {
  ELIMINATION
  SUBSTITUTION
  ENGINEERING_CONTROL
  ADMINISTRATIVE_CONTROL
  PPE
}

enum VerificationOutcome {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  NOT_EFFECTIVE
}

/// A corrective action from a risk finding or an ergonomic assessment
/// session — exactly one source, HAND-ADDED CHECK in migration SQL.
/// Ergonomic findings roll up to their AssessmentSession rather than to an
/// individual BodyRegionScore — keeps the CHECK simple and matches how an
/// EHS manager actually raises an action ("this workstation's assessment
/// found X"), not per-joint.
///
/// responsibleUserId references PlatformUser only (§3.13). Where the owner
/// is a function rather than an account, use responsibleRoleLabel — a role,
/// never a person's name.
model Action {
  id                       String               @id @default(cuid())
  siteId                   String
  riskFindingId            String?
  assessmentSessionId      String?
  title                    String
  description              String?
  hierarchyOfControl       HierarchyOfControl?
  responsibleUserId        String?              @db.Uuid
  responsibleRoleLabel     String?
  dueDate                  DateTime?
  status                   ActionStatus         @default(OPEN)
  implementedAt            DateTime?
  verifiedAt               DateTime?
  verifiedByUserId         String?              @db.Uuid
  verificationOutcome      VerificationOutcome?
  verificationAssessmentId String?
  verificationNote         String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  site                   Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  riskFinding            RiskFinding?        @relation(fields: [riskFindingId], references: [id], onDelete: Restrict)
  assessmentSession      AssessmentSession?  @relation(fields: [assessmentSessionId], references: [id], onDelete: Restrict)
  verificationAssessment RiskAssessment?     @relation("ActionVerificationAssessment", fields: [verificationAssessmentId], references: [id], onDelete: Restrict)
  statusEvents           ActionStatusEvent[]

  @@index([siteId, status])
  @@index([riskFindingId])
}

/// Append-only status history (§3.6). Never updated, never deleted.
model ActionStatusEvent {
  id         String        @id @default(cuid())
  actionId   String
  fromStatus ActionStatus?
  toStatus   ActionStatus
  byUserId   String        @db.Uuid
  note       String?
  createdAt  DateTime      @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([actionId])
}

/// An uploaded floor-plan image for a site (e.g. "Hall 2", "Ground floor").
/// `storagePath` points at the actual image in Supabase Storage; `width`/
/// `height` are the pixel dimensions of that image, which is what the
/// normalized 0..1 coordinates on WorkstationPlanPosition/TaskPlanPosition
/// are relative to.
model FloorPlan {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  storagePath String
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict, matching every other relation off Site: a site's floor plans
  // can't be wiped out as a side effect of deleting the site.
  site                     Site                      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workstationPlanPositions WorkstationPlanPosition[]
  taskPlanPositions        TaskPlanPosition[]

  @@index([siteId])
}

/// A workstation is an area, not a point — a "packaging station" might span
/// a pallet pickup spot, a wrapping table, and a stacking area meters apart.
/// This is the fallback/aggregate pin shown on a floor plan when nobody has
/// placed the workstation's individual tasks yet (see TaskPlanPosition,
/// which is the finer-grained pin a heatmap actually wants). A workstation
/// appears at most once per plan.
model WorkstationPlanPosition {
  id            String @id @default(cuid())
  floorPlanId   String
  workstationId String
  x             Float
  y             Float

  // Cascade both ways: a pin is meaningless without the plan it's placed
  // on, and a workstation's map pin has no reason to outlive the
  // workstation — unlike the assessment chain above, there's no audit
  // trail value in keeping an orphaned pin around.
  floorPlan   FloorPlan   @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  workstation Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, workstationId])
  @@index([floorPlanId])
}

/// Task-level pin on a floor plan. PostureSample already belongs to Task,
/// not Workstation, so this is the pin granularity a movement heatmap
/// actually needs — it can point at exactly which spot within a
/// workstation drives risk, rather than only the workstation as a whole.
/// A task appears at most once per plan.
model TaskPlanPosition {
  id          String @id @default(cuid())
  floorPlanId String
  taskId      String
  x           Float
  y           Float

  // Cascade both ways, same reasoning as WorkstationPlanPosition.
  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, taskId])
  @@index([floorPlanId])
}
